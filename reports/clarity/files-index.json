    "path": "cloudflare/worker-alexandria.js",
    "sha256": "45cbbcabbb0ce0f3c6584e889efb9da2938a66b2fde0ef69a3e8c92b71f97ca8",
    "bytes": 3934,
    "purpose": "worker",
