    "preview": "name: Repo - Workflows Standardize (rename + delete old)\non: { workflow_dispatch: {} }\npermissions: { contents: write }\njobs:\n  standardize:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Setup Python\n        uses: actions/setup-python@v5\n        with: { python-version: '3.x' }\n      - name: Standardize workflows (rename + keep)\n        shell: bash\n        run: |\n          set -euo pipefail\n          python - <<'PY'\n          import json, os\n          keep_path='config/workflows-keep.json'\n          map_path='config/workflows-rename.json'\n          wfdir=os.path.join('.github','workflows')\n          os.makedirs(wfdir, exist_ok=True)\n          if os.path.isfile(map_path):\n              m=json.load(open(map_path,'r',encoding='utf-8'))\n              for old,new in m.get('rename',[]):\n                  oldp=os.path.join(wfdir,old); newp=os.path.join(wfdir,new)\n                  if os.path.isfile(oldp):\n                      os.makedirs(os.path.dirname(newp), exist_ok=True)\n                      if os.path.isfile(newp):\n                          os.remove(oldp); print('Deleted duplicate',old)\n                      else:\n                          os.rename(oldp,newp); print('Renamed',old,'->',new)\n          keep=set()\n          if os.path.isfile(keep_path):\n              keep=set(json.load(open(keep_path,'r',encoding='utf-8')).get('keep',[]))\n          for fn in os.listdir(wfdir):\n              if not (fn.endswith('.yml') or fn.endswith('.yaml')): continue\n              if fn not in keep:\n                  os.remove(os.path.join(wfdir,fn)); print('Removed',fn)\n          PY\n      - name: Commit standardization\n        shell: bash\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git add .github/workflows || true\n          if git diff --cached --quiet; then echo \"No changes\"; else git commit -m \"chore(workflows): standardize (rename+delete)\" && git push; fi\n"
  },
