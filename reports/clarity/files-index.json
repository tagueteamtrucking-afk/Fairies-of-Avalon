    "preview": "\nname: Repo Sweeper (PR-based cleanup)\non:\n  workflow_dispatch: {}\npermissions:\n  contents: write\n  pull-requests: write\njobs:\n  sweep:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Read manifest\n        id: manifest\n        run: |\n          test -f \".github/cleanup/sweeper-manifest.json\"\n          echo \"paths=$(cat .github/cleanup/sweeper-manifest.json | jq -r '.delete[]?' | paste -sd ' ' -)\" >> $GITHUB_OUTPUT\n\n      - name: Delete files (staging)\n        if: steps.manifest.outputs.paths != ''\n        run: |\n          set -e\n          for p in ${{ steps.manifest.outputs.paths }}; do\n            if [ -f \"$p\" ]; then\n              git rm -f \"$p\"\n            else\n              echo \"skip (not found): $p\"\n            fi\n          done\n\n      - name: Create PR\n        if: steps.manifest.outputs.paths != ''\n        uses: peter-evans/create-pull-request@v6\n        with:\n          commit-message: \"chore: repo sweep (delete unused files)\"\n          title: \"chore: repo sweep (delete unused files)\"\n          body: |\n            Automated sweep based on .github/cleanup/sweeper-manifest.json.\n            Please review the diff carefully before merging.\n          branch: ci/repo-sweep-${{ github.run_id }}\n          base: ${{ github.ref_name }}\n"
