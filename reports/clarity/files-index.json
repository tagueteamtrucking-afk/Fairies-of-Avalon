    "preview": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Tracy • Skins & Variables</title>\n<link rel=\"stylesheet\" href=\"/pages/apps/tracy/skins/variables.css\">\n<link rel=\"stylesheet\" href=\"/pages/apps/tracy/skins/base.css\">\n</head>\n<body>\n<div class=\"wrap\">\n  <h2>🎨 Tracy • Skins & Variables</h2>\n  <p>Select a theme; all cards adopt symbols/variables instantly.</p>\n  <p>\n    <button class=\"btn\" onclick=\"setTheme('')\">Default</button>\n    <button class=\"btn\" onclick=\"setTheme('theme-autumn')\">Autumn</button>\n    <button class=\"btn\" onclick=\"setTheme('theme-noir')\">Noir</button>\n  </p>\n  <div class=\"grid\">\n    <div class=\"card\"><strong>Poster</strong><br><span class=\"badge\">Art 2D</span></div>\n    <div class=\"card\"><strong>T‑shirt</strong><br><span class=\"badge\">Art 2D</span></div>\n    <div class=\"card\"><strong>3D Asset</strong><br><span class=\"badge\">Art 3D</span></div>\n    <div class=\"card\"><strong>Web Skin</strong><br><span class=\"badge\">Skin</span></div>\n  </div>\n  <p style=\"margin-top:12px\"><a href=\"/index.html\">⬅ Home</a></p>\n</div>\n<script>\nfunction setTheme(name){\n  document.documentElement.className = name||'';\n  localStorage.setItem('TRACY_THEME', name||'');\n}\ndocument.documentElement.className = localStorage.getItem('TRACY_THEME')||'';\n</script>\n</body>\n</html>\n"
