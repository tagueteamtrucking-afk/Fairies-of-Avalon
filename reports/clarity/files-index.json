    "preview": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Stella — Guided Sessions</title>\n  <style>\n    :root{--bg:#0a0c10;--fg:#e8ecf1;--tile:#11161d;--tileb:#1b2430;--acc:#6ec1ff;--mut:#a8b3c2}\n    html,body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\n    header{padding:24px 16px;text-align:center;border-bottom:1px solid #202a36}\n    main{max-width:780px;margin:0 auto;padding:16px;display:grid;gap:16px}\n    section{background:linear-gradient(180deg,var(--tile),var(--tileb));border:1px solid #202a36;border-radius:12px;padding:16px}\n    button{padding:10px 14px;border-radius:8px;border:1px solid #202a36;background:#0f141b;color:var(--fg);cursor:pointer}\n    .mut{color:var(--mut);font-size:12px}\n  </style>\n</head>\n<body>\n  <header>\n    <h1>🌌 Stella — Guided Sessions</h1>\n    <p class=\"mut\">On-demand; browser TTS for now. No medical claims.</p>\n  </header>\n  <main>\n    <section>\n      <h2>Calm Reset</h2>\n      <p class=\"mut\">Box breathing + gentle orientation.</p>\n      <div>\n        <button data-session=\"calm\">Play</button>\n        <button id=\"stop\">Stop</button>\n      </div>\n    </section>\n    <section>\n      <h2>Focus Sprint</h2>\n      <p class=\"mut\">Short induction + NLP cueing + light binaurals (simulated verbal cueing here).</p>\n      <div>\n        <button data-session=\"focus\">Play</button>\n        <button id=\"stop2\">Stop</button>\n      </div>\n    </section>\n    <section>\n      <h2>Sleep Drift</h2>\n      <p class=\"mut\">4‑7‑8 + body scan + soft reframe for sleep.</p>\n      <div>\n        <button data-session=\"sleep\">Play</button>\n        <button id=\"stop3\">Stop</button>\n      </div>\n    </section>\n    <section>\n      <a href=\"/pages/apps/_city/index.html\" style=\"color:#6ec1ff\">← Back to City</a>\n    </section>\n  </main>\n  <script>\n    const calm = `Welcome. We'll begin with box breathing: inhale for four, hold for four, exhale for four, hold for four. Repeat three times. Release the jaw, lower the shoulders. Picture a calm horizon. You’re safe, present, and able.`;\n    const focus = `Close your eyes gently. Count down five to one. At one, your attention narrows to a single helpful task. Say quietly: Now. Begin. Maintain easy posture and steady breath as focus builds.`;\n    const sleep = `Lie comfortably. Inhale four, hold seven, exhale eight. Let the face soften. Scan the body from crown to toes; anything tight may loosen now. Imagine drifting on a quiet lake at dusk.`;\n\n    function speak(text){\n      window.speechSynthesis.cancel();\n      const u = new SpeechSynthesisUtterance(text);\n      u.rate = 0.95; u.pitch = 1.0;\n      speechSynthesis.speak(u);"
  },
  {
    "path": "pages/apps/stella/guided/20251009T185549Z-blanca-focus/script.json",
    "sha256": "cc13eabc58362e4e0c1a84c375a79917f725736a561608f3b791240ce5a07adb",
