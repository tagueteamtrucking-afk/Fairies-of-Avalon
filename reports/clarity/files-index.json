    "preview": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Sorcha — Coaching</title><style>body{background:#0b1220;color:#e6e9ff;font-family:system-ui,Segoe UI,Roboto;margin:0;padding:16px} textarea{width:100%;min-height:160px}</style></head>\n<body>\n<h1>🧠 Sorcha — Coaching Notes</h1>\n<p>Notes stay in your browser. <button onclick=\"save()\">Save (local)</button> <button onclick=\"send()\">Send to Worker</button></p>\n<textarea id=\"t\" placeholder=\"What worked? what to test next?\"></textarea>\n<pre id=\"log\"></pre>\n<script>\nfunction save(){ localStorage.setItem('sorcha_notes', document.getElementById('t').value); alert('Saved locally'); }\nasync function send(){\n  const url = localStorage.getItem('OPENAI_WORKER_URL'); if(!url){ alert('Set Worker URL first'); return; }\n  const text = document.getElementById('t').value;\n  const r = await fetch(url+'/sorcha/notes', { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({ text }) });\n  document.getElementById('log').textContent = r.ok ? 'Sent.' : 'Error';\n}\ndocument.getElementById('t').value = localStorage.getItem('sorcha_notes')||'';\n</script>\n<p><a href=\"/pages/apps/sorcha/index.html\" style=\"color:#a5d6ff\">← Back</a></p>\n</body></html>"
