    "preview": "\nname: Carol — Refresh Menu + Shopping\n\non:\n  workflow_dispatch:\n    inputs:\n      plan_path:\n        description: 'Path to the 14-day plan JSON to use'\n        required: true\n        default: pages/apps/carol/plans/twoperson-2wk-unique-20251015T022300Z.json\n\npermissions:\n  contents: write\n  pull-requests: write\n\njobs:\n  refresh:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Ensure merged plan exists (copy from chosen plan)\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = \"Stop\"\n          $src = \"${{ github.event.inputs.plan_path }}\"\n          $dst = \"pages/apps/carol/plans/twoperson-2wk-merged.json\"\n          if (!(Test-Path $src)) { throw \"Plan source not found: $src\" }\n          New-Item -ItemType Directory -Force -Path (Split-Path $dst) | Out-Null\n          Copy-Item -Force $src $dst\n          Write-Host \"Merged plan ready: $dst\"\n\n      - name: Extract shopping (v3 script)\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = \"Stop\"\n          ./scripts/Carol-Extract-Shopping-v3.ps1\n          if (!(Test-Path \"pages/apps/carol/plans/shopping-quantized.json\")) {\n            Write-Error \"Expected shopping-quantized.json was not created.\"\n          }\n\n      - name: Commit changes (if any)\n        shell: bash\n        run: |\n          set -e\n          if git status --porcelain | grep -q .; then\n            git config user.name \"github-actions[bot]\"\n            git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n            git add -A\n            git commit -m \"Carol: refresh menu pointers and shopping list\"\n          else\n            echo \"No changes to commit\"\n          fi\n\n      - name: Create Pull Request\n        uses: peter-evans/create-pull-request@v6\n        with:\n          title: \"Carol: refresh 14‑day menu & shopping list\"\n          branch: \"carol/refresh-${{ github.run_id }}\""
