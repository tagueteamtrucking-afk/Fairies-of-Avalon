    "preview": "name: Carol - Generate Shopping List (from current plan)\non:\n  workflow_dispatch:\npermissions:\n  contents: write\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 20\n      - name: Build shopping list JSON (2 people)\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = 'Stop'\n          $ptrPath = 'pages/apps/carol/index.json'\n          if (!(Test-Path $ptrPath)) { throw \"Pointer not found at $ptrPath\" }\n          $ptr = Get-Content $ptrPath -Raw | ConvertFrom-Json\n          $plan = [string]$ptr.plan\n          if ($plan.StartsWith('/')) { $plan = $plan.Substring(1) }\n          if (!(Test-Path $plan)) { throw \"Plan not found at $plan\" }\n          node scripts/carol/build-shopping.mjs --plan \"$plan\" --people 2\n      - name: Commit shopping list\n        run: |\n          git config user.name \"Carol Bot\"\n          git config user.email \"actions@users.noreply.github.com\"\n          git add pages/apps/carol/plans/shopping-quantized.json || true\n          git commit -m \"Carol: refresh shopping list from plan\" || echo \"Nothing to commit\"\n          git push || echo \"Nothing to push\"\n"
