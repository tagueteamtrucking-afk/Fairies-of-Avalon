    "preview": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n  <title>Repository Index — Viewer</title>\n  <style>\n    :root{ color-scheme: dark; --bg:#0b1220; --panel:#111a2a; --text:#e6ebff; --muted:#8aa2d3; --accent:#a5d6ff; }\n    body{margin:0;background:var(--bg);color:var(--text);font:16px/1.5 system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;}\n    header{padding:20px 24px;font-size:20px;font-weight:700;}\n    main{padding:0 24px 40px;}\n    .box{background:var(--panel);border-radius:12px;padding:16px;margin:12px 0;}\n    input[type=\"text\"]{width:100%;padding:10px 12px;border-radius:10px;border:1px solid #20304f;background:#0e1727;color:var(--text)}\n    table{width:100%;border-collapse:collapse;font-size:14px}\n    th,td{padding:8px;border-bottom:1px solid #1c2842}\n    th{text-align:left;color:var(--muted)}\n    a{color:var(--accent);text-decoration:none}\n    .mono{font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace}\n    .muted{color:var(--muted)}\n  </style>\n</head>\n<body>\n  <header>📦 Repository Index — Viewer</header>\n  <main>\n    <div class=\"box\">\n      <div id=\"meta\" class=\"muted\">Loading repo-index.json…</div>\n    </div>\n\n    <div class=\"box\">\n      <input id=\"q\" type=\"text\" placeholder=\"Filter by path (e.g., pages/apps/carol)…\"/>\n    </div>\n\n    <div class=\"box\">\n      <table id=\"summary\"></table>\n    </div>\n\n    <div class=\"box\">\n      <table id=\"files\"></table>\n    </div>\n  </main>\n\n<script>\nasync function loadJSON(path){\n  const res = await fetch(path, {cache:'no-store'});\n  if(!res.ok) throw new Error('Fetch failed: '+res.status);\n  return res.json();\n}\nfunction fmtBytes(n){ if(n==null) return '—'; const units=['B','KB','MB','GB']; let i=0; let v=n; while(v>1024 && i<3){v/=1024;i++} return v.toFixed(v<10?2:1)+' '+units[i]; }\nfunction esc(s){ return s.replace(/[&<>]/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[m])) }\n\nasync function init(){\n  const data = await loadJSON('/pages/apps/_city/repo-index.json').catch(()=>null);\n  const meta = document.getElementById('meta');\n  if(!data){ meta.textContent = 'repo-index.json not found yet. Run the “Repo — Read Index” Action.'; return; }\n  meta.innerHTML = `<div><span class=\"muted\">Repo:</span> ${esc(data.repo)} — <span class=\"muted\">Files:</span> ${data.count} — <span class=\"muted\">SHA:</span> <span class=\"mono\">${esc(data.sha)}</span> — <span class=\"muted\">Generated:</span> ${esc(data.generated)}</div>`;\n\n  // Summary\n  const summary = await fetch('/memory-history/repo-usage-report.json',{cache:'no-store'}).then(r=>r.ok?r.json():null).catch(()=>null);\n  const t1 = document.getElementById('summary');\n  if(summary && summary.summary){"
