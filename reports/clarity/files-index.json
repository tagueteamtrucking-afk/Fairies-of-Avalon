    "preview": "name: Root - Fix 404 & Redirect to Plaza\non: { workflow_dispatch: {} }\npermissions: { contents: write }\njobs:\n  fix:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Write index.html + kill-sw\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p pages\n          cat > index.html <<'HTML'\n          <!doctype html><html lang=\"en\"><head>\n          <meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>\n          <title>Avalon</title>\n          <meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\">\n          <meta http-equiv=\"Pragma\" content=\"no-cache\"><meta http-equiv=\"Expires\" content=\"0\">\n          </head><body style=\"background:#0b1220;color:#e5e7eb;font-family:system-ui,Segoe UI,Roboto;display:grid;place-items:center;min-height:100vh\">\n          <div>Launching City Plaza… If not redirected, <a style=\"color:#a5b4fc\" href=\"/pages/plaza.html\">tap here</a>.</div>\n          <script>(async()=>{try{if('serviceWorker'in navigator){const r=await navigator.serviceWorker.getRegistrations();for(const x of r){await x.unregister();}if(window.caches){const k=await caches.keys();for(const c of k){await caches.delete(c);}}}}catch(e){}location.replace('/pages/plaza.html?cb='+Date.now().toString(36));})();</script>\n          <noscript><meta http-equiv=\"refresh\" content=\"0; url=/pages/plaza.html\"></noscript>\n          </body></html>\n          HTML\n          cat > kill-sw-boost.html <<'HTML'\n          <!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Kill SW</title></head>\n          <body style=\"background:#0b1220;color:#e5e7eb;font-family:system-ui,Segoe UI,Roboto;padding:16px\">\n          <h1>Service Worker & Cache Reset</h1><pre id=\"log\">Running…</pre>\n          <script>(async()=>{const L=[];const log=m=>{L.push(m);document.getElementById('log').textContent=L.join('\\n')};try{if('serviceWorker'in navigator){const r=await navigator.serviceWorker.getRegistrations();for(const x of r){await x.unregister();log('Unregistered SW');}}if(window.caches){const k=await caches.keys();for(const c of k){await caches.delete(c);log('Cache deleted '+c);}}}catch(e){log('Error '+e)}log('Done.');})();</script>\n          </body></html>\n          HTML\n      - name: Commit\n        shell: bash\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git add index.html kill-sw-boost.html\n          if git diff --cached --quiet; then echo \"No changes\"; else git commit -m \"fix(root): 404 -> plaza redirect + SW reset\" && git push; fi\n"
