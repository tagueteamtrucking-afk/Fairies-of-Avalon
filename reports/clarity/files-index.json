    "preview": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Carol — 14‑Day Menu</title>\n<style>\n  :root{--pad:16px;--max:960px}\n  body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,sans-serif;margin:0;padding:var(--pad);max-width:var(--max);margin-inline:auto;background:#f8f9fb}\n  header{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-bottom:12px}\n  h1{font-size:1.25rem;margin:0}\n  .btn{display:inline-block;padding:8px 12px;border:1px solid #ddd;border-radius:8px;text-decoration:none;color:#111;background:#fff}\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}\n  .card{background:#fff;border:1px solid #eee;border-radius:12px;padding:12px}\n  .day{font-weight:600;margin:0 0 6px 0}\n  .event{margin:8px 0}\n  .name{font-weight:600}\n  @media print{\n    header,.btn{display:none !important}\n    body{background:#fff}\n    .grid{display:block}\n    .card{page-break-after:always;break-after:page;margin:0;border:none}\n  }\n</style>\n<header>\n  <h1>Carol — 14‑Day Menu</h1>\n  <div>\n    <a class=\"btn\" href=\"/pages/apps/carol/shopping.html\">Shopping List</a>\n    <button class=\"btn\" onclick=\"window.print()\">Print Menu</button>\n  </div>\n</header>\n<section id=\"days\" class=\"grid\" aria-live=\"polite\"></section>\n<script type=\"module\">\nconst state = { plan:null };\nasync function loadPlan(){\n  const ptr = await fetch('/pages/apps/carol/index.json').then(r=>r.json());\n  if(!ptr || !ptr.plan_latest) throw new Error('Pointer missing \"plan_latest\"');\n  state.plan = await fetch('/'+ptr.plan_latest).then(r=>r.json());\n  render();\n}\nfunction render(){\n  const root = document.getElementById('days');\n  root.innerHTML = '';\n  for(const d of state.plan.days){\n    const card = document.createElement('article');\n    card.className='card';\n    card.innerHTML = `<h2 class=\"day\">${d.day_label}</h2>`;\n    for(const e of d.events){\n      const div = document.createElement('div');\n      div.className='event';\n      div.innerHTML = `<div class=\"name\">${e.name}</div><div class=\"meta\">${e.time_hint||''} • ${e.type}</div>`;\n      card.appendChild(div);\n    }\n    root.appendChild(card);\n  }\n}\nloadPlan().catch(err=>{\n  document.getElementById('days').innerHTML = `<div class=\"card\">Plan not found. Check <code>pages/apps/carol/index.json</code>.</div>`;\n  console.error(err);\n});\n</script>\n</html>\n"
