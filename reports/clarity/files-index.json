    "preview": "name: Alexandria - Voice DM (pages & logs)\non: { workflow_dispatch: {} }\npermissions: { contents: write }\njobs:\n  dm:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Seed Voice DM page + sessions log\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p pages/apps/alexandria/sessions\n          cat > pages/apps/alexandria/voice-dm.html <<'HTML'\n          <!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Alexandria — Voice DM</title></head>\n          <body style=\"background:#0b1220;color:#e5e7eb;font-family:system-ui,Segoe UI,Roboto;margin:0;padding:16px\">\n            <h1>🎲 Alexandria — Voice DM</h1>\n            <p><label>Worker URL <input id=\"w\" size=\"60\" placeholder=\"https://your-worker.workers.dev\"></label>\n               <button onclick=\"save()\">Save</button></p>\n            <p><button onclick=\"start()\">🎤 Start</button> <button onclick=\"stop()\">⏹️ Stop</button></p>\n            <pre id=\"log\" style=\"white-space:pre-wrap\"></pre>\n            <script>\n              function save(){ localStorage.setItem('OPENAI_WORKER_URL', document.getElementById('w').value); alert('Saved'); }\n              let media, rec, chunks=[];\n              async function start(){\n                try{\n                  media = await navigator.mediaDevices.getUserMedia({audio:true});\n                  rec = new MediaRecorder(media);\n                  rec.ondataavailable = e => { if(e.data.size>0) chunks.push(e.data); };\n                  rec.onstop = async () => {\n                    const blob = new Blob(chunks,{type:'audio/webm'}); chunks=[];\n                    const url = localStorage.getItem('OPENAI_WORKER_URL'); if(!url){ alert('Set Worker URL first'); return; }\n                    const fd = new FormData(); fd.append('audio', blob, 'input.webm');\n                    const resp = await fetch(url+'/alexandria-dm', { method:'POST', body: fd });\n                    const text = await resp.text();\n                    const id = new Date().toISOString().replace(/[:.]/g,'-');\n                    await fetch('/pages/apps/alexandria/sessions/'+id+'.txt', { method:'PUT', body:text });\n                    const tts = await fetch(url+'/speak', { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({text}) });\n                    const buf = await tts.arrayBuffer(); new Audio(URL.createObjectURL(new Blob([buf]))).play();\n                    document.getElementById('log').textContent = text;\n                  };\n                  rec.start(); document.getElementById('log').textContent='Recording…';\n                }catch(e){ document.getElementById('log').textContent='Error: '+e; }\n              }\n              function stop(){ if(rec){ rec.stop(); if(media){ media.getTracks().forEach(t=>t.stop()); } } }\n            </script>\n          </body></html>\n          HTML\n      - name: Commit pages\n        shell: bash\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git add pages/apps/alexandria/voice-dm.html || true\n          if git diff --cached --quiet; then echo \"No changes\"; else git commit -m \"feat(alexandria): voice DM page\" && git push; fi\n"
  },
