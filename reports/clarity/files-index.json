    "preview": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n  <title>Jem • Week 1 Evaluation</title>\n  <link rel=\"stylesheet\" href=\"plan.css\">\n</head>\n<body>\n<header>\n  <h1>Jem · Week 1: Baseline & Gentle Routine</h1>\n  <p class=\"sub\">Morning warm‑up · Mid‑shift micro‑break · Evening mobility. Space‑limited, truck‑safe, no equipment.</p>\n</header>\n\n<section class=\"pane\">\n  <div>\n    <label>Person</label>\n    <select id=\"who\">\n      <option value=\"Ray\">Ray</option>\n      <option value=\"Blanca\">Blanca</option>\n    </select>\n  </div>\n  <div>\n    <button id=\"loadPlan\">Load Today</button>\n    <button id=\"saveLog\">Save Progress</button>\n  </div>\n</section>\n\n<section id=\"today\"></section>\n\n<section class=\"eval\">\n  <h2>Quick Baseline Tests (log once this week)</h2>\n  <div class=\"grid2\">\n    <div class=\"card\">\n      <h3>30s Sit‑to‑Stand</h3>\n      <label>Reps</label><input id=\"sts_reps\" type=\"number\" min=\"0\" step=\"1\"/>\n      <small>Standard chair; arms crossed if safe.</small>\n    </div>\n    <div class=\"card\">\n      <h3>Plank Hold</h3>\n      <label>Seconds</label><input id=\"plank_sec\" type=\"number\" min=\"0\" step=\"1\"/>\n      <small>Knees down is OK. Stop for pain or dizziness.</small>\n    </div>\n    <div class=\"card\">\n      <h3>Push‑ups</h3>\n      <label>Style</label>\n      <select id=\"push_style\"><option>Wall</option><option>Knees</option><option>Full</option></select>\n      <label>Reps</label><input id=\"push_reps\" type=\"number\" min=\"0\" step=\"1\"/>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <p class=\"note\">Safety: stop if chest pain, unusual shortness of breath, or dizziness. For hypertension, favor moderate‑intensity aerobic work and low‑to‑moderate resistance; breathe continuously (avoid Valsalva).</p>\n</footer>\n\n<script src=\"plan.js\"></script>\n</body>\n</html>\n"
  },
