    "preview": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Carol — Shopping List (2 people)</title>\n<style>\n  :root{--pad:16px;--max:900px}\n  body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,sans-serif;margin:0;padding:var(--pad);max-width:var(--max);margin-inline:auto;background:#f8f9fb}\n  header{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-bottom:12px}\n  h1{font-size:1.25rem;margin:0}\n  .btn{display:inline-block;padding:8px 12px;border:1px solid #ddd;border-radius:8px;text-decoration:none;color:#111;background:#fff}\n  .group{background:#fff;border:1px solid #eee;border-radius:12px;margin:10px 0;padding:12px}\n  .group h2{margin:0 0 8px 0;font-size:1rem}\n  ul{margin:0;padding-left:18px}\n  @media print{header{display:none} body{background:#fff} .group{page-break-inside:avoid}}\n</style>\n<header>\n  <h1>Carol — Shopping List</h1>\n  <div>\n    <button class=\"btn\" onclick=\"window.print()\">Print List</button>\n    <button class=\"btn\" id=\"build\">Build in Browser</button>\n  </div>\n</header>\n<div id=\"list\"></div>\n<script type=\"module\">\nconst CAT = {\n  produce:['apple','banana','pear','kiwi','peach','grapes','mango','pineapple','tomato','cucumber','spinach','lettuce','lemon','potatoes','sweet potato','avocado'],\n  protein:['chicken','turkey','salmon','cod','tuna','egg','eggs','ground turkey','lean turkey'],\n  dairy:['yogurt','cottage','mozzarella','cheese','milk','cream cheese'],\n  grains:['oats','rice','tortilla','bread','crackers','panko','granola','rice cakes'],\n  frozen:['frozen','mixed vegetables'],\n  pantry:['olive oil','hummus','peanut butter','flax','chia','cocoa','tomato soup','diced tomatoes','beans']\n};\nfunction catOf(name){\n  const n=name.toLowerCase();\n  if(n.includes('frozen')) return 'Frozen';\n  if(n.includes('vegetables')) return 'Frozen';\n  if(CAT.produce.some(w=>n.includes(w))) return 'Produce';\n  if(CAT.protein.some(w=>n.includes(w))) return 'Protein';\n  if(CAT.dairy.some(w=>n.includes(w))) return 'Dairy';\n  if(CAT.grains.some(w=>n.includes(w))) return 'Grains';\n  if(CAT.frozen.some(w=>n.includes(w))) return 'Frozen';\n  return 'Pantry';\n}\nfunction normName(n){\n  n = String(n||'').trim().toLowerCase();\n  n = n.replace(/\\s+\\(canned in juice.*\\)/g,'').replace(/\\s+\\(in water\\)/g,'');\n  n = n.replace(/lactose[-\\s]?free/g,'lactose-free');\n  n = n.replace(/mixed vegetables.*|frozen mixed vegetables/g,'mixed vegetables, frozen');\n  n = n.replace(/lf /g,'lactose-free ');\n  n = n.replace(/yogurt.*greek.*/g,'yogurt, greek (lactose-free)');\n  n = n.replace(/cottage cheese.*/g,'cottage cheese (lactose-free)');\n  n = n.replace(/^egg$/,'eggs');\n  return n;\n}\nfunction asNumber(v){const n=Number(v);return isFinite(n)?n:0}\nfunction add(map,key,qty,unit){\n  const k = normName(key);\n  const entry = map.get(k) || {name:k, qty:0, unit:unit||''};\n  // if units differ, prefer first seen unit; we only sum like-units here\n  if(entry.unit === (unit||'') || !entry.unit) entry.qty += asNumber(qty);\n  map.set(k, entry);\n}"
  },
