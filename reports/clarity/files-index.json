    "preview": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Billie • Storyboards</title>\n  <link rel=\"stylesheet\" href=\"../theme/tokens.css\">\n  <style>\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;margin:0;background:var(--bg);color:var(--fg)}\n    header{padding:18px 20px;border-bottom:1px solid var(--border);background:var(--panel-bg)}\n    h1{margin:0;font-size:20px}\n    main{padding:16px 20px;max-width:900px;margin:0 auto}\n    .card{background:var(--panel-bg);border:1px solid var(--border);border-radius:14px;padding:14px;margin:12px 0}\n    h2{margin:0 0 8px 0;font-size:16px}\n    .muted{opacity:.85}\n    .note{background:var(--panel-bg); border:1px solid var(--border); border-radius:12px; padding:12px 14px; margin:12px 0}\n  </style>\n</head>\n<body>\n<header><h1>Billie — Storyboards</h1></header>\n<main>\n  <div id=\"pinInfo\" class=\"note muted\">PG‑13 only. For private items, keep them off‑site.</div>\n  <div id=\"slot\" class=\"card\">\n    <h2>Latest Storyboard (from Sorcha)</h2>\n    <div id=\"story\"></div>\n  </div>\n  <script>\n    (async function(){\n      try{\n        const res = await fetch('/pages/apps/sorcha/storyboards/storyboard-20251019T033626Z.json',{cache:'no-store'});\n        if(!res.ok) throw 0;\n        const data = await res.json();\n        const el = document.getElementById('story');\n        el.textContent = JSON.stringify(data, null, 2);\n      }catch(_){\n        document.getElementById('story').innerHTML = '<div class=\"muted\">No storyboard JSON found yet. Add one under <code>pages/apps/billie/storyboards/</code> or use Sorcha’s storyboard as a seed.</div>';\n      }\n    })();\n  </script>\n  <div class=\"card\">\n    <h2>Actions</h2>\n    <ul>\n      <li>Create a new JSON in <code>pages/apps/billie/storyboards/</code> (e.g., <code>storyboard-YYYYMMDDThhmmssZ.json</code>).</li>\n      <li>Reference it here or in Sorcha’s storyboard viewer.</li>\n    </ul>\n  </div>\n</main>\n</body>\n</html>\n"
