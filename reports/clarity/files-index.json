    "preview": "name: Nina - City Tiles\non: { workflow_dispatch: {} }\npermissions: { contents: write }\njobs:\n  tiles:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Theme registry icons (BOM-safe)\n        shell: bash\n        run: |\n          set -euo pipefail\n          file=\"pages/apps/_city/registry.json\"\n          [ -f \"$file\" ] || { echo \"registry.json missing; run Charlotte - Link Registry\"; exit 0; }\n          tmp=\"$(mktemp)\"\n          node - <<'JS' \"$file\" \"$tmp\"\n          const fs=require('fs'); const p=process.argv[2]; const o=process.argv[3];\n          let text = fs.readFileSync(p,'utf8'); if(text.charCodeAt(0)===0xFEFF) text=text.slice(1);\n          const reg=JSON.parse(text); const icons={\n            alexandria:\"📚\", charlotte:\"📡\", nina:\"🧪\", tracy:\"🎨\", carol:\"🍽️\", jem:\"🥋\",\n            stella:\"🌌\", abbey:\"🏦\", themis:\"⚖️\", billie:\"💰\", sorcha:\"🎬\", clarice:\"🔐\"\n          };\n          reg.items = (reg.items||[]).filter(it=> (it.name||'').toLowerCase()!=='odessa')\n            .map(it=>({ ...it, icon: icons[(it.name||'').toLowerCase()] || it.icon || '🏛️'}));\n          fs.writeFileSync(o, JSON.stringify(reg,null,2));\n          JS\n          mv \"$tmp\" \"$file\"\n      - name: Commit tiles\n        shell: bash\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git add pages/apps/_city/registry.json || true\n          if git diff --cached --quiet; then echo \"No changes\"; else git commit -m \"feat(nina): city icons (BOM-safe) & remove Odessa\" && git push; fi\n"
  },
