  {
    "path": "pages/apps/stella/stella.js",
    "sha256": "f29df077b1ae1eb5ad377cd4f38d064aec7b6170fcc325b3a6464fb7af200c81",
    "bytes": 4184,
    "purpose": "app-page",
    "imports": [],
    "links": [],
    "refs": [],
    "preview": "(()=>{\n  const log = s => { const el=document.getElementById('log'); el.textContent += s + \"\\n\"; el.scrollTop=el.scrollHeight; };\n  let ctx, master, nodes=[], timer=null, current=null;\n\n  function ac(){ if(!ctx){ ctx=new (window.AudioContext||window.webkitAudioContext)(); master=ctx.createGain(); master.gain.value=parseFloat(document.getElementById('vol').value||0.35); master.connect(ctx.destination); } }\n\n  function whiteNoise(){\n    const buffer = ctx.createBuffer(2, ctx.sampleRate*2, ctx.sampleRate);\n    for(let ch=0; ch<2; ch++){\n      const data = buffer.getChannelData(ch);\n      for(let i=0; i<data.length; i++) data[i] = (Math.random()*2-1)*0.6;\n    }\n    const src = ctx.createBufferSource(); src.buffer=buffer; src.loop=true;\n    const g = ctx.createGain(); g.gain.value = 0.3;\n    src.connect(g).connect(master);\n    src.start(); return [src,g];\n  }\n  function filteredNoise(type='pink'){\n    // start with white then gentle shelves for character; approximation only\n    const [src,g] = whiteNoise();\n    const biq1 = ctx.createBiquadFilter(); biq1.type='lowshelf'; biq1.frequency.value=200; biq1.gain.value=(type==='brown'?10:5);\n    const biq2 = ctx.createBiquadFilter(); biq2.type='highshelf'; biq2.frequency.value=4000; biq2.gain.value=(type==='brown'?-12:(type==='pink'?-6:-2));\n    g.disconnect();\n    src.connect(biq1).connect(biq2).connect(master);\n    return [src,biq1,biq2];\n  }\n  function binaural(base=220, diff=8){\n    const l = ctx.createOscillator(); const r = ctx.createOscillator();\n    const g = ctx.createGain(); g.gain.value=0.15;\n    const split = ctx.createChannelMerger(2);\n    const panL = new StereoPannerNode(ctx,{pan:-1});\n    const panR = new StereoPannerNode(ctx,{pan: 1});\n    l.frequency.value=base; r.frequency.value=base+diff;\n    l.connect(panL).connect(split,0,0);\n    r.connect(panR).connect(split,0,1);\n    split.connect(g).connect(master);\n    l.start(); r.start(); return [l,r,g,split,panL,panR];\n  }\n  function tone(freq=432){\n    const o=ctx.createOscillator(), g=ctx.createGain(); o.type='sine'; o.frequency.value=freq; g.gain.value=0.12; o.connect(g).connect(master); o.start(); return [o,g];\n  }\n\n  function stopAll(){\n    nodes.forEach(n=>{ try{ (n.stop?n.stop():0); if(n.disconnect) n.disconnect(); }catch(e){} });\n    nodes=[]; if(timer){ clearTimeout(timer); timer=null; }\n    document.querySelectorAll('.tile').forEach(b=>b.classList.remove('active'));\n    current=null; log('Stopped.');\n  }\n\n  function setVol(v){ if(master){ master.gain.value=parseFloat(v)||0.35; } }\n\n  function play(mode){\n    ac(); stopAll(); const mins = Math.max(1, Math.min(120, parseInt(document.getElementById('mins').value||'20',10)));\n    let config='';\n    switch(mode){\n      case 'focus':\n        nodes.push(...filteredNoise('pink')); nodes.push(...binaural(220, 10)); config='pink noise + binaural ~10Hz (focus)';\n        break;\n      case 'calm':\n        nodes.push(...filteredNoise('brown')); nodes.push(...tone(432)); config='brown noise + 432Hz tone (calm)';"
  },
  {
    "path": "pages/apps/stella/voice.html",
    "sha256": "fdfcbcd59b9724c2388404b4d889bffd3a005d7f3cd4cd0e0af5360fcc00276b",
    "bytes": 4109,
    "purpose": "app-page",
    "imports": [],
    "links": [],
    "refs": [],
    "preview": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Stella — Voice</title><style>body{background:#0b0f17;color:#e5e7eb;font-family:system-ui,Segoe UI,Roboto;margin:0}main{max-width:860px;margin:0 auto;padding:14px}.card{background:#0f172a;border:1px solid #172033;border-radius:12px;padding:12px;margin:10px 0}.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1 1 180px}.btn{padding:8px 10px;border:1px solid #334155;border-radius:10px;background:#0b1220;color:#e5e7eb;cursor:pointer}</style></head>\n<body><main>\n<h1>Stella — Voice I/O</h1>\n<div class=\"card\"><div class=\"row\"><label>Voice<select id=\"voice\"><option>shimmer</option><option>alloy</option><option>verse</option><option>amber</option><option>coral</option></select></label><label>Model<select id=\"model\"><option>tts-1-hd</option><option>tts-1</option></select></label></div></div>\n<div class=\"card\"><h3>TTS</h3><div class=\"row\"><input id=\"ttsText\" placeholder=\"Type for Stella to speak\"><button class=\"btn\" id=\"ttsBtn\">Speak</button></div><audio id=\"ttsAudio\" controls></audio></div>\n<div class=\"card\"><h3>STT</h3><div class=\"row\"><button class=\"btn\" id=\"recBtn\">Hold to record</button><input id=\"sttOut\" placeholder=\"Transcript here\"></div></div>\n<div class=\"card\"><h3>Chat</h3><div class=\"row\"><textarea id=\"chatInput\" rows=\"3\" placeholder=\"Meditation/Hypnosis: Success, Drive, Luck, Gratitude, Gateway\"></textarea><button class=\"btn\" id=\"chatBtn\">Send</button></div><div id=\"chatOut\"></div></div>\n</main>\n<script>\nconst W = localStorage.getItem('stella:worker') || 'https://YOUR-WORKER.SUBDOMAIN.workers.dev';\nconst vSel = document.getElementById('voice'); vSel.value = localStorage.getItem('stella:voice') || 'shimmer';\nconst mSel = document.getElementById('model'); mSel.value = localStorage.getItem('stella:model') || 'tts-1-hd';\nvSel.onchange=()=>localStorage.setItem('stella:voice', vSel.value);\nmSel.onchange=()=>localStorage.setItem('stella:model', mSel.value);\nasync function ttsSpeak(text){ const r=await fetch(W+'/tts',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({text,voice:vSel.value,model:mSel.value})}); const b=await r.blob(); const u=URL.createObjectURL(b); const a=document.getElementById('ttsAudio'); a.src=u; a.play(); }\ndocument.getElementById('ttsBtn').onclick=()=>{ const t=document.getElementById('ttsText').value.trim(); if(t) ttsSpeak(t); };\nlet mediaStream, mediaRecorder, chunks=[]; const recBtn=document.getElementById('recBtn');\nrecBtn.onmousedown=recBtn.ontouchstart=async()=>{ try{ mediaStream=await navigator.mediaDevices.getUserMedia({audio:true}); chunks=[]; mediaRecorder=new MediaRecorder(mediaStream,{mimeType:'audio/webm'}); mediaRecorder.ondataavailable=e=>{ if(e.data.size>0) chunks.push(e.data); }; mediaRecorder.onstop=async()=>{ const blob=new Blob(chunks,{type:'audio/webm'}); const fd=new FormData(); fd.append('file',blob,'audio.webm'); const r=await fetch(W+'/stt',{method:'POST',body:fd}); const j=await r.json(); const t=j.text||''; document.getElementById('sttOut').value=t; }; mediaRecorder.start(); recBtn.textContent='Release to stop'; } catch(e){ alert('Mic failed: '+e.message); } };\nrecBtn.onmouseup=recBtn.ontouchend=()=>{ if(mediaRecorder&&mediaRecorder.state==='recording'){ mediaRecorder.stop(); recBtn.textContent='Hold to record'; } };\ndocument.getElementById('chatBtn').onclick=async()=>{ const txt=document.getElementById('chatInput').value.trim(); if(!txt) return; const sys='You are Stella, a compassionate hypnosis/meditation guide. Keep scripts safe, supportive, and 5–8 minutes. Categories: Success, Determination/Drive, Luck/Fortune, Happiness/Gratitude, Gateway Program mental development.'; const r=await fetch(W+'/chat',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messages:[{role:'system',content:sys},{role:'user',content:txt}]})}); const j=await r.json(); const c=j.choices?.[0]?.message?.content||JSON.stringify(j); document.getElementById('chatOut').textContent=c; ttsSpeak(c); };\n</script></body></html>"
  },
