    "preview": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Kill Service Worker</title></head>\n<body>\n<h1>Service worker reset</h1>\n<p>If a service worker is installed, this page will unregister it and then reload.</p>\n<script>\n(async()=>{\n  if ('serviceWorker' in navigator){\n    const regs = await navigator.serviceWorker.getRegistrations();\n    for (const r of regs){ try{ await r.unregister(); }catch(e){} }\n  }\n  localStorage.clear(); sessionStorage.clear(); caches && caches.keys && caches.keys().then(keys=>keys.forEach(k=>caches.delete(k)));\n  setTimeout(()=>location.href='/', 800);\n})();\n</script>\n</body></html>\n"
