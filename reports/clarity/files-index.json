    "preview": "name: PR Automerge Comment Bot\n\non:\n  pull_request_target:\n    types:\n      - opened\n      - reopened\n      - synchronize\n      - labeled\n      - edited\n      - ready_for_review\n      - review_requested\n      - review_request_removed\n      - unlocked\n      - converted_to_draft\n      - auto_merge_enabled\n      - auto_merge_disabled\n\npermissions:\n  contents: read\n  checks: read\n  statuses: read\n  pull-requests: write\n  issues: write\n\njobs:\n  explain-non-automerge:\n    if: github.event.pull_request.merged == false\n    runs-on: ubuntu-latest\n    steps:\n      - name: Explain why PR did not auto-merge\n        uses: actions/github-script@v7\n        with:\n          script: |\n            const pr = context.payload.pull_request;\n            const owner = context.repo.owner;\n            const repo = context.repo.repo;\n            const HEADER = \"### 🤖 Automerge Comment Bot — Status Check\";\n\n            const { data: fresh } = await github.rest.pulls.get({ owner, repo, pull_number: pr.number });\n\n            const reasons = [];\n            const labels = new Set(fresh.labels.map(l => l.name.toLowerCase()));\n            const hasAutomerge = labels.has(\"automerge\");\n            const hasHold = labels.has(\"hold\");\n            const isDraft = fresh.draft;\n\n            if (!hasAutomerge) reasons.push(\"No **`automerge`** label on this PR.\");\n            if (hasHold) reasons.push(\"The **`hold`** label is present (merges are blocked until it is removed).\");\n            if (isDraft) reasons.push(\"This PR is still in **Draft** state.\");\n\n            const reviews = await github.paginate(github.rest.pulls.listReviews, { owner, repo, pull_number: pr.number });\n            const approvals = reviews.filter(r => r.state === \"APPROVED\");\n            if (approvals.length < 1) reasons.push(\"No **approving review** found. (Branch protection may require one.)\");\n\n            const head_sha = fresh.head.sha;\n            const { data: status } = await github.rest.repos.getCombinedStatusForRef({ owner, repo, ref: head_sha });\n            const failingStatuses = status.statuses.filter(s => s.state !== \"success\");\n            const checks = await github.paginate(github.rest.checks.listForRef, { owner, repo, ref: head_sha });\n            const failingChecks = checks.filter(cr => cr.status !== \"completed\" || (cr.conclusion && ![\"success\",\"neutral\",\"skipped\"].includes(cr.conclusion)));"
