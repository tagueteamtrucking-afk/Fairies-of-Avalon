    "preview": "name: City — Link Prefix Patch\non:\n  workflow_dispatch:\n\npermissions:\n  contents: write\n  pull-requests: write\n\njobs:\n  patch:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Rewrite /apps/ → /pages/apps/ in .html/.js\n        shell: pwsh\n        run: |\n          $files = Get-ChildItem -Recurse -Include *.html,*.js -Path .\n          $changed = 0\n          foreach($f in $files){\n            $t = Get-Content $f.FullName -Raw\n            $n = $t -replace '(?<!/pages)/apps/', '/pages/apps/'\n            if($n -ne $t){\n              Set-Content -NoNewline -Path $f.FullName -Value $n\n              $changed++\n            }\n          }\n          \"Changed files: $changed\"\n\n      - name: Create Pull Request\n        uses: peter-evans/create-pull-request@v6\n        with:\n          commit-message: \"fix(city): rewrite /apps/* → /pages/apps/* to avoid 404 on GH Pages\"\n          branch: \"city/prefix-patch-${{ github.run_id }}\"\n          title: \"City: Prefix patch for app links\"\n          body: |\n            Rewrites `/apps/` → `/pages/apps/` in HTML/JS so links resolve on GH Pages host.\n"
