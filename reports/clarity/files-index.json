    "preview": "name: Crown of Clarity — Sweeper Proposal (non-destructive)\non:\n  workflow_dispatch:\npermissions:\n  contents: write\n  pull-requests: write\njobs:\n  sweep:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Build proposal from analysis (duplicates only; unreferenced placeholder)\n        run: |\n          mkdir -p reports/clarity\n          git ls-files -z | xargs -0 -I{} sha256sum \"{}\" > _all.sha\n          sort _all.sha > _all.sorted.sha\n          awk '{print $1}' _all.sorted.sha | uniq -d > _dups.sha\n          echo '{\"duplicates\":[' > reports/clarity/sweeper-proposal.json\n          first=1\n          while read -r H; do\n            files=$(grep \"^${H} \" _all.sorted.sha | awk '{print $2}' | jq -R -s 'split(\"\\n\")|map(select(length>0))')\n            if [ $first -eq 0 ]; then echo ',' >> reports/clarity/sweeper-proposal.json; fi\n            echo \"{\\\"sha256\\\":\\\"${H}\\\",\\\"files\\\":${files}}\" >> reports/clarity/sweeper-proposal.json\n            first=0\n          done < _dups.sha\n          echo '],\"unreferenced\":[]}' >> reports/clarity/sweeper-proposal.json\n\n      - name: Upload proposal\n        uses: actions/upload-artifact@v4\n        with:\n          name: clarity-sweeper-proposal\n          path: reports/clarity/sweeper-proposal.json\n\n      - name: PR — add proposal JSON\n        uses: peter-evans/create-pull-request@v6\n        with:\n          commit-message: \"clarity(sweeper): add proposal (duplicates + unreferenced placeholder)\"\n          title: \"clarity(sweeper): add proposal\"\n          branch: \"ci/clarity-sweeper-${{ github.run_id }}\"\n          base: \"${{ github.ref_name }}\"\n          add-paths: |\n            reports/clarity/sweeper-proposal.json\n"
  },
