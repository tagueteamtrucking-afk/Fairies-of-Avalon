    "preview": "name: Crown of Clarity - Core (catalog + snapshot + site crawl)\non:\n  push:\n    branches:\n      - main\n  workflow_dispatch:\n\npermissions:\n  contents: write\n  actions: read\n  issues: write\n  pull-requests: write\n\njobs:\n  core:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Install tools\n        run: |\n          sudo apt-get update -y\n          sudo apt-get install -y jq wget zip\n\n      - name: Prepare folders\n        run: |\n          mkdir -p reports/clarity\n          mkdir -p urls\n          mkdir -p response-check\n          mkdir -p snapshot\n\n      - name: Build file catalog (path, sha256, bytes)\n        shell: bash\n        run: |\n          git ls-files -z | xargs -0 -I{} bash -lc '\n            p=\"{}\"\n            b=$(stat -c %s \"{}\")\n            h=$(sha256sum \"{}\" | awk \"{print \\$1}\")\n            printf \"%s\\t%s\\t%s\\n\" \"$p\" \"$h\" \"$b\"\n          ' > reports/clarity/catalog.tsv\n          jq -R -s '\n            split(\"\\n\")\n            | map(select(length>0) | split(\"\\t\"))\n            | map({path: .[0], sha256: .[1], bytes: (.[2]|tonumber)})\n          ' < reports/clarity/catalog.tsv > reports/clarity/catalog.json\n\n      - name: Create repo snapshot artifact (zip of repo HEAD)\n        shell: bash\n        run: |\n          git ls-files -z | xargs -0 -I{} bash -lc '\n            mkdir -p \"snapshot/$(dirname \"{}\")\"\n            cp \"{}\" \"snapshot/{}\"\n          ' || true\n          (cd snapshot && zip -r ../repo-snapshot.zip .)\n\n      - name: Discover site URLs from index and /pages\n        shell: bash\n        run: |\n          BASE=\"https://fairiesofavalon.com\""
