    "preview": "name: Repo Sweeper (propose deletions)\n\non:\n  workflow_dispatch: {}\n  schedule:\n    - cron: \"49 3 * * *\"\n\npermissions:\n  contents: write\n  pull-requests: write\n\njobs:\n  sweep:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Setup jq and micromatch\n        run: |\n          sudo apt-get update && sudo apt-get install -y jq\n          npm i micromatch\n\n      - name: Compute cleanup proposal\n        id: plan\n        run: |\n          node - <<'JS'\n          const fs = require('fs'); const micromatch = require('micromatch');\n          const idx = JSON.parse(fs.readFileSync('memory/file-index.json','utf8'));\n          const rules = JSON.parse(fs.readFileSync('memory/cleanup-rules.json','utf8'));\n          const files = idx.files;\n\n          function preserved(p){ return micromatch.isMatch(p, rules.preserveGlobs||[]); }\n\n          const byHash = {};\n          for (const f of files) { (byHash[f.hash] ||= []).push(f); }\n\n          const deletes = [];\n          for (const f of files) {\n            if (preserved(f.path)) continue;\n\n            let doomed = false; let reason = '';\n            for (const r of rules.deleteIf||[]) {\n              if (r.glob && !micromatch.isMatch(f.path, r.glob)) continue;\n              if (r.sizeLT && !(f.bytes < r.sizeLT)) continue;\n              doomed = true; reason = r.reason || `rule ${JSON.stringify(r)}`; break;\n            }\n            if (doomed) { deletes.push({path:f.path, reason}); continue; }\n\n            const dup = byHash[f.hash];\n            if (dup && dup.length > 1) {\n              const max = dup.reduce((a,b)=> a.bytes>=b.bytes?a:b);\n              if (f.path !== max.path) deletes.push({path:f.path, reason:'duplicate content'});\n            }\n          }\n\n          fs.mkdirSync('memory', {recursive:true});\n          fs.writeFileSync('memory/cleanup-proposals.json', JSON.stringify({generated:new Date().toISOString(), deletes}, null, 2));\n          console.log(`Found ${deletes.length} deletions`);\n          JS\n"
  },
