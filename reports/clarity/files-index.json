    "preview": "name: Actions Audit (list workflows & last runs)\non:\n  workflow_dispatch:\n    inputs:\n      lookback_hours:\n        description: 'Hours back to inspect'\n        required: true\n        default: '48'\njobs:\n  audit:\n    runs-on: ubuntu-latest\n    permissions:\n      actions: read\n      contents: read\n      issues: write\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n      - name: Gather data via GitHub API\n        id: gather\n        uses: actions/github-script@v7\n        with:\n          script: |\n            const hours = parseInt(core.getInput('lookback_hours') || '48', 10);\n            const since = new Date(Date.now() - hours*60*60*1000).toISOString();\n            const owner = context.repo.owner;\n            const repo  = context.repo.repo;\n            const wfResp = await github.rest.actions.listRepoWorkflows({owner, repo, per_page: 200});\n            const workflows = wfResp.data.workflows || [];\n            const lines = [];\n            for (const wf of workflows) {\n              const runsResp = await github.rest.actions.listWorkflowRuns({owner, repo, workflow_id: wf.id, per_page: 10, created: `>=${since}`});\n              const runs = runsResp.data.workflow_runs || [];\n              const latest = runs[0];\n              lines.push(`- **${wf.name}** (${wf.path}) → ` +\n                (latest ? `*${latest.status}/${latest.conclusion}* ${latest.html_url}` : 'no runs in window') +\n                `; runs=${runs.length}`);\n            }\n            const md = [\n              `## Actions Audit (last ${hours}h)`,\n              `Since: ${since}`,\n              '',\n              ...lines\n            ].join('\\n');\n            core.setOutput('markdown', md);\n      - name: Save report\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p audit\n          cat > audit/actions-audit.md << 'EOF'\n          ${{ steps.gather.outputs.markdown }}\n          EOF\n      - name: Upload report artifact\n        uses: actions/upload-artifact@v4\n        with:\n          name: actions-audit\n          path: audit/actions-audit.md\n          if-no-files-found: error\n      - name: Create/Update issue with results"
  },
