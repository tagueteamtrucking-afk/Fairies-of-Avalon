    "preview": "name: Carol - Inspect Plan\non: { workflow_dispatch: {} }\npermissions: { contents: write }\njobs:\n  inspect:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Inspect pointer and plan JSON\n        shell: pwsh\n        run: |\n          $ErrorActionPreference=\"Stop\"\n          $root = $env:GITHUB_WORKSPACE\n          $ptrPath = Join-Path $root \"pages/apps/carol/index.json\"\n          if(Test-Path $ptrPath){\n            $ptr = Get-Content -Raw -LiteralPath $ptrPath | ConvertFrom-Json\n            Write-Host \"Pointer: $($ptr | ConvertTo-Json -Depth 5)\"\n            if($ptr.plan){\n              $planPath = (Join-Path $root ($ptr.plan.TrimStart('/')))\n              if(Test-Path $planPath){\n                $plan = Get-Content -Raw -LiteralPath $planPath | ConvertFrom-Json\n                $days = @($plan.menu.days); if(-not $days){ $days = @($plan.days) }\n                $count = ($days | Measure-Object).Count\n                Write-Host \"Plan exists at $planPath with $count days\"\n              }else{\n                Write-Error \"Pointer.plan file not found at $planPath\"\n              }\n            } else {\n              Write-Error \"Pointer.plan is null\"\n            }\n          } else {\n            Write-Error \"Pointer file missing at $ptrPath\"\n          }\n      - name: Write debug JSON\n        shell: bash\n        run: |\n          mkdir -p pages/apps/carol/debug\n          echo '{}' > pages/apps/carol/debug/plan-inspect.json\n      - name: Commit debug stub\n        shell: bash\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git add pages/apps/carol/debug/plan-inspect.json || true\n          if git diff --cached --quiet; then echo \"No changes\"; else git commit -m \"chore(carol): debug stub\" && git push; fi\n"
