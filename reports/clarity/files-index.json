    "preview": "name: LLM Bootstrap Bundle (One-Click)\non:\n  workflow_dispatch:\n    inputs:\n      crawl_url:\n        description: 'Root URL to snapshot (e.g., https://fairiesofavalon.com)'\n        required: true\n        default: 'https://fairiesofavalon.com'\n      crawl_depth:\n        description: 'Crawl depth (1-3 is typical)'\n        required: true\n        default: '2'\npermissions:\n  contents: read\n  actions: read\njobs:\n  gather:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Ensure tools\n        run: |\n          sudo apt-get update -y\n          sudo apt-get install -y jq wget zip\n      - name: Repo file list (sizes)\n        run: |\n          git ls-files -z | xargs -0 -I{} bash -lc 'printf \"%s\\t%s\\n\" \"$(stat -c %s \"{}\")\" \"{}\"' | sort -n > _repo_files_sizes.tsv\n          jq -Rn '[inputs|split(\"\\t\")|{bytes:(.[0]|tonumber),path:.[1]}]|{generated:now,files:.}' < _repo_files_sizes.tsv > _repo_files_sizes.json\n      - name: Workflows list + latest runs\n        id: wf\n        uses: actions/github-script@v7\n        with:\n          script: |\n            const owner = context.repo.owner, repo = context.repo.repo;\n            const wfs = await github.rest.actions.listRepoWorkflows({owner, repo, per_page: 200});\n            const workflows = wfs.data.workflows || [];\n            const out = [];\n            for (const wf of workflows) {\n              const runs = await github.rest.actions.listWorkflowRuns({owner, repo, workflow_id: wf.id, per_page: 1});\n              const latest = runs.data.workflow_runs && runs.data.workflow_runs[0];\n              out.push({\n                id: wf.id, name: wf.name, path: wf.path, state: wf.state,\n                latest: latest ? {status: latest.status, conclusion: latest.conclusion, url: latest.html_url, updated_at: latest.updated_at} : null\n              });\n            }\n            require('fs').writeFileSync('_workflows.json', JSON.stringify({generated:(new Date()).toISOString(), workflows: out}, null, 2));\n      - name: Cloudflare inventory\n        env:\n          CF_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}\n          CF_ACCOUNT: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}\n        run: |\n          set -euo pipefail\n          mkdir -p _cf\n          if [ -z \"${{ secrets.CLOUDFLARE_API_TOKEN }}\" ]; then\n            echo '{\"warning\":\"CLOUDFLARE_API_TOKEN missing\"}' > _cf/warning.json\n          else\n            curl -fsSL -H \"Authorization: Bearer $CF_TOKEN\" \"https://api.cloudflare.com/client/v4/accounts/$CF_ACCOUNT/workers/scripts\" > _cf/workers.json || echo '{\"error\":\"workers list failed\"}' > _cf/workers.json\n            curl -fsSL -H \"Authorization: Bearer $CF_TOKEN\" \"https://api.cloudflare.com/client/v4/accounts/$CF_ACCOUNT/workers/filters\" > _cf/filters.json || echo '{\"error\":\"filters list failed\"}' > _cf/filters.json\n            curl -fsSL -H \"Authorization: Bearer $CF_TOKEN\" \"https://api.cloudflare.com/client/v4/accounts/$CF_ACCOUNT/pages/projects\" > _cf/pages.json || echo '{\"error\":\"pages list failed\"}' > _cf/pages.json\n          fi"
