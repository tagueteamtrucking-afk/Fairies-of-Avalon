    "preview": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n  <title>Avalon · PIN Configuration</title>\n  <style>\n    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Helvetica,Arial,sans-serif;margin:0;padding:20px;background:#0b0e13;color:#e9eef5}\n    .card{max-width:680px;margin:0 auto;background:#12161d;border:1px solid #2a3240;border-radius:12px;padding:18px}\n    input,select,button{font:inherit}\n    input[type=\"password\"]{width:100%;padding:10px;border-radius:8px;border:1px solid #2a3240;background:#0b0e13;color:#e9eef5}\n    .row{display:flex;gap:10px;align-items:center;margin:10px 0}\n    .list{margin:10px 0 0 0;padding:0;list-style:none}\n    .item{display:flex;gap:10px;align-items:center;margin:6px 0}\n    .item span{display:inline-block;min-width:80px}\n    .hint{color:#aab7cf}\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <h1>PIN Configuration</h1>\n    <p class=\"hint\">Add up to 10 four-digit PINs. Choose a role for each (e.g., <code>dev</code> for you). The list is stored locally in this browser’s <code>localStorage</code>.</p>\n\n    <div class=\"row\">\n      <input id=\"pin\" type=\"password\" inputmode=\"numeric\" pattern=\"\\d{4}\" maxlength=\"4\" minlength=\"4\" placeholder=\"4-digit PIN\" />\n      <select id=\"role\">\n        <option value=\"user\">user</option>\n        <option value=\"dev\">dev</option>\n      </select>\n      <button id=\"add\">Add</button>\n      <button id=\"clear\" style=\"margin-left:auto\">Clear All</button>\n    </div>\n\n    <ul id=\"list\" class=\"list\"></ul>\n\n    <p class=\"hint\">Security truth: on a static site, this is a convenience feature, not strong security. For real access control, use an edge worker (e.g., Cloudflare) or a server with authenticated sessions.</p>\n    <p><a href=\"/pages/apps/_city/index.html\" style=\"color:#8ab4ff\">← Back to City</a></p>\n  </div>\n\n<script>\nconst toHex = (buf)=>[...new Uint8Array(buf)].map(b=>b.toString(16).padStart(2,\"0\")).join(\"\");\nasync function sha256(s){const enc=new TextEncoder();return toHex(await crypto.subtle.digest(\"SHA-256\", enc.encode(s)));}\nfunction getList(){ try{return JSON.parse(localStorage.getItem(\"avalon:pin-hashes\")||\"[]\");}catch{return [];} }\nfunction setList(list){ localStorage.setItem(\"avalon:pin-hashes\", JSON.stringify(list)); }\nfunction render(){\n  const list = getList();\n  const ul = document.getElementById(\"list\");\n  ul.innerHTML = \"\";\n  list.forEach((rec, i)=>{\n    const li = document.createElement(\"li\");\n    li.className = \"item\";\n    li.innerHTML = `<span>${rec.role||\"user\"}</span><code>${rec.hash.slice(0,10)}…</code> <button data-i=\"${i}\">Remove</button>`;\n    ul.appendChild(li);\n  });\n  ul.querySelectorAll(\"button[data-i]\").forEach(btn=>btn.addEventListener(\"click\", ev=>{\n    const idx = Number(ev.currentTarget.dataset.i);\n    const list = getList();\n    list.splice(idx,1); setList(list); render();\n  }));\n}"
  },
