    "preview": "<!-- pages/apps/carol/print-menu.html -->\n<!doctype html><html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\"/>\n  <title>Carol • Print Menu (One Day per Page)</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n  <link rel=\"stylesheet\" href=\"./print.css\"/>\n  <script>\n  async function loadPointer(){\n    const candidates = [\n      '/pages/apps/carol/index.json',\n      './index.json',\n      '../carol/index.json'\n    ];\n    for(const url of candidates){\n      try{\n        const res = await fetch(url, { cache: 'no-store' });\n        if(res.ok){ return await res.json(); }\n      }catch{}\n    }\n    throw new Error('Pointer index.json not found. Add File: pages/apps/carol/index.json');\n  }\n  async function loadPlan(pathOrObj){\n    if(typeof pathOrObj === 'string'){\n      const res = await fetch(pathOrObj, { cache:'no-store' });\n      if(!res.ok) throw new Error('Plan JSON not found at '+pathOrObj);\n      return res.json();\n    }\n    return pathOrObj;\n  }\n  function renderDay(d){\n    const wrap = document.createElement('section');\n    wrap.className = 'day';\n    const h = document.createElement('h2');\n    h.textContent = d.day_label || ('Day ' + d.index);\n    wrap.appendChild(h);\n    (d.events||[]).forEach(ev=>{\n      const e = document.createElement('div');\n      e.className = 'event no-break';\n      const title = document.createElement('div');\n      title.innerHTML = '<strong>'+ev.name+'</strong>';\n      const meta = document.createElement('div');\n      meta.className = 'meta';\n      meta.textContent = [ev.type, ev.time_hint, ev.for].filter(Boolean).join(' • ');\n      e.appendChild(title);\n      e.appendChild(meta);\n      if(ev.items && ev.items.length){\n        const ul = document.createElement('ul');\n        ev.items.forEach(it=>{\n          const li = document.createElement('li');\n          const qty = (it.quantity!==undefined && it.unit) ? ` (${it.quantity} ${it.unit})` : '';\n          li.textContent = `${it.ingredient}${qty}${it.notes? ' — '+it.notes:''}`;\n          ul.appendChild(li);\n        });\n        e.appendChild(ul);\n      }\n      if(ev.instructions && ev.instructions.length){\n        const ul = document.createElement('ul');\n        ev.instructions.forEach(t=>{\n          const li = document.createElement('li'); li.textContent = t; ul.appendChild(li);"
  },
