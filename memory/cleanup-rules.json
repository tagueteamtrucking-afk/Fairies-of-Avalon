{
  "preserveGlobs": [
    "asset/models/**",
    "asset/wings/**",
    ".github/workflows/**",
    "memory/**",
    "index.html",
    "importmap.json",
    "pages/apps/nina/**",
    "pages/apps/charlotte/**",
    "pages/apps/billie/**",
    "pages/apps/tracy/**",
    "pages/apps/jem/**",
    "pages/apps/carol/**",
    "pages/apps/alexandria/**",
    "pages/apps/stella/**",
    "pages/apps/overseers/**",
    "pages/apps/clarice/index.html",
    "pages/apps/themis/index.html",
    "pages/apps/odessa/index.html",
    "pages/apps/sorcha/index.html"
  ],
  "deleteIf": [
    {
      "glob": "pages/apps/clarice/**",
      "reason": "legacy (merged into Nina) except redirect index.html"
    },
    {
      "glob": "pages/apps/themis/**",
      "reason": "legacy (merged into Charlotte) except redirect index.html"
    },
    {
      "glob": "pages/apps/odessa/**",
      "reason": "legacy (merged into Billie) except redirect index.html"
    },
    {
      "glob": "pages/apps/sorcha/**",
      "reason": "legacy (merged into Billie) except redirect index.html"
    },
    {
      "glob": "**/*.tmp",
      "reason": "temporary file"
    },
    {
      "glob": "**/*~",
      "reason": "editor backup"
    },
    {
      "glob": "**/.DS_Store",
      "reason": "system file"
    },
    {
      "glob": "**/Thumbs.db",
      "reason": "system file"
    },
    {
      "glob": "pages/**",
      "sizeLT": 12,
      "reason": "empty stub page"
    }
  ],
  "duplicateHashPolicy": "delete-all-but-largest"
}