    "preview": "<!doctype html><html lang=\"en\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Carol — Nutrition Dashboard</title>\n<link rel=\"stylesheet\" href=\"../../assets/css/avalon-dashboard.css\">\n</head><body>\n<header class=\"av-head\"><div class=\"wrap\">\n  <h1>🍎 Carol — Nutrition Dashboard</h1>\n  <p class=\"sub\">Live view of plan & shopping. Source of truth: <code>pages/apps/carol/</code> JSON files.</p>\n</div></header>\n<main class=\"wrap grid\">\n  <section class=\"card\">\n    <h2>Plan Report</h2>\n    <pre id=\"planReport\" class=\"mono muted\">Loading plan-report.json…</pre>\n  </section>\n  <section class=\"card\">\n    <h2>Shopping (Quantized)</h2>\n    <table id=\"shop\" class=\"table\"><thead><tr><th>Item</th><th>Qty</th><th>Notes</th></tr></thead><tbody></tbody></table>\n    <div id=\"shopEmpty\" class=\"muted\" hidden>shopping-quantized.json was empty.</div>\n  </section>\n  <section class=\"card\">\n    <h2>Preferences</h2>\n    <pre id=\"prefs\" class=\"mono muted\">Loading preferences.json…</pre>\n  </section>\n</main>\n\n<script type=\"module\">\nasync function loadJSON(p){ try{ const r=await fetch(p+'?t='+Date.now(),{cache:'no-store'}); if(!r.ok) throw new Error(r.status); return await r.json(); }catch(e){ return null; } }\n\nconst rep = await loadJSON('../carol/plan-report.json');\ndocument.getElementById('planReport').textContent = rep ? JSON.stringify(rep,null,2) : 'plan-report.json not found. Run “Carol Refresh (shopping & report)”.';\n\nconst shop = await loadJSON('../carol/shopping-quantized.json');\nconst tbody = document.querySelector('#shop tbody');\nif (shop && Array.isArray(shop.items) && shop.items.length){\n  tbody.innerHTML = shop.items.slice(0,500).map(x=>`<tr><td>${(x.name||'').replace(/[&<>]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]))}</td><td>${x.qty||''}</td><td>${x.notes||''}</td></tr>`).join('');\n}else{\n  document.getElementById('shopEmpty').hidden = false;\n}\n\nconst prefs = await loadJSON('../carol/profile/preferences.json');\ndocument.getElementById('prefs').textContent = prefs ? JSON.stringify(prefs,null,2) : 'preferences.json not found. Open Phoenix to save.';\n</script>\n</body></html>\n"
