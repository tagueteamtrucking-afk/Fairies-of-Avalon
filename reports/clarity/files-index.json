    "preview": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Reset Service Worker</title></head>\n<body style=\"font-family:system-ui;padding:20px\">\n<h1>Reset &amp; Bypass Cache</h1>\n<p>This page unregisters any Service Worker and reloads the site without cache.</p>\n<script>\n(async () => {\n  if ('serviceWorker' in navigator) {\n    const regs = await navigator.serviceWorker.getRegistrations();\n    for (const r of regs) { try { await r.unregister(); } catch(e){} }\n  }\n  caches && caches.keys && caches.keys().then(keys => keys.forEach(k => caches.delete(k)));\n  const u = new URL(location.href);\n  u.searchParams.set('cb', Date.now());\n  setTimeout(()=> location.href = u.toString(), 600);\n})();\n</script>\n</body></html>\n"
