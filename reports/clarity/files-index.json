    "preview": "name: Repo — Read Index\non:\n  workflow_dispatch:\n\npermissions:\n  contents: write\n\njobs:\n  read:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n\n      - name: Build repo index JSON\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = \"Stop\"\n          git config --global --add safe.directory $PWD\n          $paths = git ls-files\n          $items = @()\n          foreach($p in $paths){\n            if(-not [string]::IsNullOrWhiteSpace($p)){\n              try {\n                $fi = Get-Item -LiteralPath $p -ErrorAction Stop\n                $items += [pscustomobject]@{ path=$p; bytes=$fi.Length; mtime=$fi.LastWriteTimeUtc.ToString(\"o\") }\n              } catch {\n                $items += [pscustomobject]@{ path=$p; bytes=$null; mtime=$null }\n              }\n            }\n          }\n          $index = [pscustomobject]@{\n            repo = \"${{ github.repository }}\"\n            sha = \"${{ github.sha }}\"\n            generated = (Get-Date).ToString(\"o\")\n            count = $items.Count\n            files = $items\n          }\n          $json = $index | ConvertTo-Json -Depth 6\n          New-Item -ItemType Directory -Force -Path \"memory-history\" | Out-Null\n          New-Item -ItemType Directory -Force -Path \"pages/apps/_city\" | Out-Null\n          Set-Content -Path \"memory-history/repo-index.json\" -Value $json -Encoding UTF8\n          Set-Content -Path \"pages/apps/_city/repo-index.json\" -Value $json -Encoding UTF8\n\n          # Also write a small by-folder summary\n          $folderStats = @()\n          foreach($g in ($items | Group-Object { ($_.path -split '/')[0] })) {\n            $folderStats += [pscustomobject]@{ folder=$g.Name; files=$g.Count; bytes=($g.Group | Measure-Object -Property bytes -Sum).Sum }\n          }\n          $report = [pscustomobject]@{\n            repo = \"${{ github.repository }}\"\n            generated = (Get-Date).ToString(\"o\")\n            summary = $folderStats | Sort-Object -Property folder\n          }\n          ($report | ConvertTo-Json -Depth 5) | Set-Content -Path \"memory-history/repo-usage-report.json\" -Encoding UTF8\n\n      - name: Commit repo index\n        uses: stefanzweifel/git-auto-commit-action@v5"
