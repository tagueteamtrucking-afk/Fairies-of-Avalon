    "preview": "name: Site — Fix App Links to /pages/apps\non:\n  workflow_dispatch: {}\npermissions:\n  contents: write\njobs:\n  fix:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Rewrite broken /apps paths to /pages/apps\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = 'Stop'\n          $files = Get-ChildItem -Recurse -Include *.html,*.css,*.js -Path pages\n          foreach($f in $files){\n            $c = Get-Content $f.FullName -Raw\n            $new = $c -replace 'href=\"/apps/','href=\"/pages/apps/' -replace \"href='/apps/\",\"href='/pages/apps/\"\n            if($new -ne $c){ Set-Content $f.FullName $new -Encoding UTF8 }\n          }\n          git config user.email \"actions@github.com\"\n          git config user.name \"github-actions[bot]\"\n          git add pages\n          if ((git diff --cached --name-only).Length -gt 0){\n            git commit -m \"Site: fix /apps/* links to /pages/apps/*\"\n            git push origin HEAD:main\n          } else {\n            Write-Host \"No link changes needed.\"\n          }\n"
