    "preview": "name: Auto-approve & Automerge (label-gated)\n\non:\n  pull_request_target:\n    types: [labeled, synchronize, opened, reopened, ready_for_review]\n\npermissions:\n  contents: write\n  pull-requests: write\n  statuses: read\n  checks: read\n\njobs:\n  approve-and-merge:\n    if: >\n      contains(github.event.pull_request.labels.*.name, 'automerge') &&\n      !github.event.pull_request.draft\n    runs-on: ubuntu-latest\n\n    steps:\n      - name: Ensure CI is green\n        uses: actions-ecosystem/action-wait-for-check@v1\n        with:\n          token: ${{ secrets.GITHUB_TOKEN }}\n          intervalSeconds: 10\n          timeoutSeconds: 3600\n\n      - name: Auto-approve (for bots / safe areas)\n        if: |\n          contains(github.event.pull_request.labels.*.name, 'bot') ||\n          contains(github.event.pull_request.labels.*.name, 'docs') ||\n          contains(github.event.pull_request.labels.*.name, 'workflows') ||\n          contains(github.event.pull_request.labels.*.name, 'site')\n        uses: hmarr/auto-approve-action@v4\n        with:\n          github-token: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Automerge (squash) when eligible\n        uses: pascalgn/automerge-action@v0.16.3\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          MERGE_LABELS: automerge\n          MERGE_METHOD: squash\n          MERGE_DELETE_BRANCH: \"true\"\n          MERGE_BLOCK_LABELS: hold\n"
  },
