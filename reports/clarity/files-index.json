assThru | Out-Null\n  }catch{\n    Write-Warning \"TTS call failed: $($_.Exception.Message). Writing placeholder text.\"\n    Set-Content -LiteralPath (Join-Path $outDir ($t.id + '.txt')) -Value $t.ssml -Encoding UTF8\n  }\n}\nWrite-Host \"Voiceovers written to $outDir\"\n"
