    "preview": "name: Observability (catalog + crawl + actions) on push\non:\n  push:\n    branches:\n      - main\n  workflow_dispatch:\npermissions:\n  contents: write\n  actions: read\n  issues: write\n  pull-requests: write\njobs:\n  observe:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Install tools\n        run: |\n          sudo apt-get update -y\n          sudo apt-get install -y jq wget\n\n      - name: Build File Catalog (path, size, sha256)\n        run: |\n          git ls-files -z | xargs -0 -I{} bash -lc 'printf \"%s\\t%s\\n\" \"$(stat -c %s \"{}\")\" \"{}\"' > _sizes.tsv\n          git ls-files -z | xargs -0 -I{} bash -lc 'sha256sum \"{}\"' > _sha.tsv\n          awk '{print $2\"\\t\"$1}' _sha.tsv | sort > _sha.sorted\n          sort _sizes.tsv > _sizes.sorted\n          join -t $'\\t' -1 1 -2 1 _sha.sorted _sizes.sorted > _join.tsv\n          jq -Rn -f- <<'JQ' > reports_catalog.json\n            [inputs | split(\"\\n\")[] | select(length>0) | split(\"\\t\")] as $rows\n            | $rows | map({ path: .[0], sha256: .[1], bytes: (.[2]|tonumber) })\n            | { generated: \"NOW\", files: . }\n          JQ\n        env:\n          NOW: \"2025-10-31T18:08:16\"\n\n      - name: Small site crawl (1 level)\n        run: |\n          mkdir -p site_snapshot\n          wget --quiet --page-requisites --adjust-extension --level=1 --no-parent --directory-prefix=site_snapshot https://fairiesofavalon.com || true\n\n      - name: Actions Digest (list workflows + latest run if any)\n        id: digest\n        uses: actions/github-script@v7\n        with:\n          script: |\n            const fs = require('fs');\n            const owner = context.repo.owner, repo = context.repo.repo;\n            const workflows = (await github.rest.actions.listRepoWorkflows({owner, repo, per_page:200})).data.workflows || [];\n            const out = [];\n            for (const wf of workflows) {\n              const runs = (await github.rest.actions.listWorkflowRuns({owner, repo, workflow_id: wf.id, per_page:1})).data.workflow_runs || [];\n              const latest = runs[0] ? {\n                status: runs[0].status, conclusion: runs[0].conclusion, url: runs[0].html_url, updated_at: runs[0].updated_at\n              } : null;\n              out.push({name: wf.name, path: wf.path, state: wf.state, latest});\n            }\n            fs.writeFileSync('actions_digest.json', JSON.stringify({generated: new Date().toISOString(), workflows: out}, null, 2));"
  },
