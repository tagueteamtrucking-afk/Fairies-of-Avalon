    "preview": "<!doctype html><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Apps — Fairies of Avalon</title>\n<style>\nbody{font-family:system-ui;background:#0b0f17;color:#e5e7eb;margin:0}header{padding:12px 16px;border-bottom:1px solid #172033}\nmain{padding:16px}.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}\n.card{border:1px solid #172033;border-radius:10px;padding:14px;background:#0f172a}\n.card a{color:#e5e7eb;text-decoration:none;font-weight:600}\nsmall{color:#9ca3af}\n</style>\n<header><h1>Microapps</h1><small>Choose a tool</small></header>\n<main><div class=\"grid\">\n  <div class=\"card\"><a href=\"/pages/apps/alexandria/dm/play.html\">Alexandria — DM</a><br><small>Talk to the DM (Worker)</small></div>\n  <div class=\"card\"><a href=\"/pages/apps/alexandria/worlds/\">Alexandria — Worlds</a><br><small>World bibles</small></div>\n  <div class=\"card\"><a href=\"/pages/apps/stella/guided.html\">Stella — Guided</a><br><small>Meditation player</small></div>\n  <div class=\"card\"><a href=\"/pages/apps/jem/dashboard.html\">Jem — Dashboard</a><br><small>Programs + Biometrics</small></div>\n  <div class=\"card\"><a href=\"/pages/apps/carol/\">Carol — Meal Plans</a><br><small>Plans & exports</small></div>\n  <div class=\"card\"><a href=\"/pages/apps/charlotte/\">Charlotte — Pipelines</a><br><small>Site/translation</small></div>\n  <div class=\"card\"><a href=\"/pages/apps/nina/\">Nina — 3D & assets</a><br><small>VRM index soon</small></div>\n  <div class=\"card\"><a href=\"/pages/apps/clarice/\">Clarice — Snapshots</a><br><small>Memory & backups</small></div>\n</div></main>\n"
