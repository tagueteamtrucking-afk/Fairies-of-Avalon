sset/textures/wallpapers/$(N $sel.carol)');\n  --room-jem-bg:        url('/asset/textures/wallpapers/$(N $sel.jem)');\n  --room-stella-bg:     url('/asset/textures/wallpapers/$(N $sel.stella)');\n  --room-sorcha-bg:     url('/asset/textures/wallpapers/$(N $sel.sorcha)');\n  --room-odessa-bg:     url('/asset/textures/wallpapers/$(N $sel.odessa)');\n  --room-billie-bg:     url('/asset/textures/wallpapers/$(N $sel.billie)');\n  --room-themis-bg:     url('/asset/textures/wallpapers/$(N $sel.themis)');\n  --room-abbey-bg:      url('/asset/textures/wallpapers/$(N $sel.abbey)');\n  --room-clarice-bg:    url('/asset/textures/wallpapers/$(N $sel.clarice)');\n  --room-overseers-bg:  url('/asset/textures/wallpapers/$(N $sel.overseers)');\n}\n.hero{background-image: var(--hero-bg); background-size:cover; background-position:center; background-repeat:no-repeat; min-height:38vh; border-radius:12px; border:1px solid #172033}\n.room-bg{ background-size:cover; background-position:center; background-repeat:no-repeat; border-radius:12px; border:1px solid #172033; min-height:30vh }\n.room-bg.alexandria{background-image: var(--room-alexandria-bg)}\n.room-bg.charlotte{background-image: var(--room-charlotte-bg)}\n.room-bg.nina{background-image: var(--room-nina-bg)}\n.room-bg.tracy{background-image: var(--room-tracy-bg)}\n.room-bg.carol{background-image: var(--room-carol-bg)}\n.room-bg.jem{background-image: var(--room-jem-bg)}\n.room-bg.stella{background-image: var(--room-stella-bg)}\n.room-bg.sorcha{background-image: var(--room-sorcha-bg)}\n.room-bg.odessa{background-image: var(--room-odessa-bg)}"
