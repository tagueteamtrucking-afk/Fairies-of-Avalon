    "preview": "*{box-sizing:border-box}body{margin:0;font-family:system-ui,Segoe UI,Roboto,Helvetica,Arial;background:#0b0f17;color:#e5e7eb}\nheader{padding:16px 20px;border-bottom:1px solid #172033}\nh1{margin:0 0 6px 0;font-weight:700}\n.sub{margin:0;color:#9ca3af}\nmain{padding:16px 20px}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}\n.tile{padding:18px;border-radius:10px;border:1px solid #172033;background:#111827;color:#e5e7eb;font-size:18px;cursor:pointer}\n.tile.active{outline:2px solid #60a5fa}\n.ctrls{display:flex;gap:12px;align-items:center;margin-top:14px}\n.ctrls label{display:inline-flex;gap:8px;align-items:center;background:#0f172a;border:1px solid #172033;border-radius:8px;padding:8px 10px}\n#stop{background:#ef4444;border:none;border-radius:8px;color:#fff;padding:10px 14px;cursor:pointer}\n.log{margin-top:14px;min-height:60px;font-family:ui-monospace,Menlo,Consolas,monospace;background:#0f172a;border:1px solid #172033;border-radius:8px;padding:10px;white-space:pre-wrap}\n"
