    "preview": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Alexandria — DM (Audio-Fixed)</title>\n<style>\n*{box-sizing:border-box}body{margin:0;font-family:system-ui,Segoe UI,Roboto,Helvetica,Arial;background:#0b0f17;color:#e5e7eb}\nheader{padding:12px 16px;border-bottom:1px solid #172033}h1{margin:0 0 4px 0}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}\nmain{padding:16px;display:grid;gap:12px}.controls button{margin-right:6px}\n.chat{border:1px solid #172033;border-radius:8px;padding:12px;background:#0f172a}\n#log{height:48vh;overflow:auto;padding:8px;background:#0b1220;border:1px solid #172033;margin-bottom:8px}\n.msg{padding:6px 8px;margin:6px 0;border-radius:6px;max-width:82%}.msg.you{background:#1f2a44;margin-left:auto}.msg.dm{background:#192235}\n.composer{display:flex;gap:8px}.composer input{flex:1;padding:8px;border:1px solid #334155;border-radius:6px;background:#0b1220;color:#e5e7eb}\n.badge{border:1px solid #334155;border-radius:6px;padding:2px 6px;font-size:12px}\n</style>\n</head><body>\n<header><h1>Alexandria — DM</h1><small>Enable Audio, choose TTS engine, Connect Worker (persisted), then Grant Mic if you want push‑to‑talk.</small></header>\n<main>\n  <section class=\"controls\">\n    <div class=\"row\">\n      <span class=\"badge\">TTS Engine:</span>\n      <label><input type=\"radio\" name=\"tts_engine\" value=\"worker\" checked> Worker</label>\n      <label><input type=\"radio\" name=\"tts_engine\" value=\"browser\"> Browser</label>\n      <button id=\"test-voice\">Test Voice</button>\n      <button id=\"enable-audio\">Enable Audio</button>\n      <button id=\"connect\">Connect Worker</button>\n      <button id=\"check\">Check Worker</button>\n      <label><input type=\"checkbox\" id=\"tts\" checked> Speak replies</label>\n      <button id=\"grant-mic\">Grant Mic</button>\n      <button id=\"ptt\">🎙 Hold to Talk</button>\n    </div>\n  </section>\n  <section class=\"chat\">\n    <div id=\"log\"></div>\n    <div class=\"composer\">\n      <input id=\"msg\" placeholder=\"Say something to the DM...\">\n      <button id=\"send\">Send</button>\n    </div>\n  </section>\n</main>\n<script>\n(function(){\n  const cfgUrl = '../config.json';\n  const radios = [...document.querySelectorAll('input[name=\"tts_engine\"]')];\n  const ttsEl = document.getElementById('tts');\n  const logEl = document.getElementById('log');\n  const input = document.getElementById('msg');\n  let api = null, recorder=null, chunks=[], mime='', mediaStream=null;\n  let engine = localStorage.getItem('ALEX_TTS_ENGINE') || 'worker';\n\n  function setEngine(val){ engine = val; localStorage.setItem('ALEX_TTS_ENGINE', engine); }\n  radios.forEach(r=>{ r.checked = (r.value===engine); r.addEventListener('change', ()=>setEngine(r.value)); });\n\n  function line(text, who){ const el = document.createElement('div'); el.className='msg ' + (who||'dm'); el.textContent = text; logEl.appendChild(el); logEl.scrollTop = logEl.scrollHeight; }\n\n  function playAudioDataUrl(u){\n    try{ const a=new Audio(); a.src=u; a.play().catch(()=>{}); }catch(e){}\n  }\n  function speakBrowser(text){\n    try{\n      const u = new SpeechSynthesisUtterance(text);\n      u.rate = 1.0; u.pitch = 1.0;"
  },
