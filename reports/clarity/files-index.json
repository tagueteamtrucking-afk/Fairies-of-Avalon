    "preview": "\nname: Repo Doctor (read-only reports)\non:\n  workflow_dispatch: {}\npermissions:\n  contents: read\n  actions: read\n  issues: write\njobs:\n  audit:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Ensure Node & tools\n        run: |\n          node --version || sudo apt-get update -y && sudo apt-get install -y nodejs npm\n          npm --version || true\n\n      - name: Run doctor\n        run: |\n          node scripts/overseers/repo-doctor.mjs\n\n      - name: Upload artifacts\n        uses: actions/upload-artifact@v4\n        with:\n          name: repo-doctor\n          path: |\n            reports/repo-doctor/summary.md\n            reports/repo-doctor/duplicates.json\n            reports/repo-doctor/large-files.json\n            reports/repo-doctor/orphaned-pages.json\n            reports/repo-doctor/dead-workflows.json\n            reports/repo-doctor/bare-specifiers.json\n\n      - name: Open/Update Repo Doctor issue\n        uses: actions/github-script@v7\n        with:\n          script: |\n            const fs = require('fs');\n            const owner = context.repo.owner, repo = context.repo.repo;\n            const md = fs.readFileSync('reports/repo-doctor/summary.md', 'utf8');\n            const title = 'Repo Doctor — Cleanup Report';\n            const { data: issues } = await github.rest.issues.listForRepo({owner, repo, state:'open'});\n            const existing = issues.find(i => i.title === title);\n            if (existing) {\n              await github.rest.issues.update({owner, repo, issue_number: existing.number, body: md});\n            } else {\n              await github.rest.issues.create({owner, repo, title, body: md, labels: ['overseer']});\n            }\n"
