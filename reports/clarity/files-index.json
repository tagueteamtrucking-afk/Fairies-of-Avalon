    "preview": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Sorcha — Uploader</title><style>body{background:#0b1220;color:#e6e9ff;font-family:system-ui,Segoe UI,Roboto;margin:0;padding:16px} a{color:#a5d6ff}</style></head>\n<body>\n<h1>📤 Sorcha — Upload Reference Clips</h1>\n<p><label>Worker URL <input id=\"w\" size=\"60\" placeholder=\"https://your-worker.workers.dev\"></label> <button onclick=\"save()\">Save</button></p>\n<input id=\"f\" type=\"file\" accept=\"video/*\" multiple>\n<button onclick=\"send()\">Upload</button>\n<pre id=\"log\"></pre>\n<script>\nfunction save(){ localStorage.setItem('OPENAI_WORKER_URL', document.getElementById('w').value); alert('Saved'); }\nasync function send(){\n  const url = localStorage.getItem('OPENAI_WORKER_URL'); if(!url){ alert('Set Worker URL first'); return; }\n  const files = document.getElementById('f').files; if(!files.length){ alert('Choose files'); return; }\n  const log = document.getElementById('log'); log.textContent='Uploading…';\n  for(const file of files){\n    const fd = new FormData(); fd.append('video', file, file.name);\n    const r = await fetch(url+'/sorcha/upload', { method:'POST', body: fd });\n    log.textContent += '\\n' + file.name + ': ' + (r.ok?'OK':'Error');\n  }\n}\n</script>\n<p><a href=\"/pages/apps/sorcha/index.html\">← Back</a></p>\n</body></html>"
