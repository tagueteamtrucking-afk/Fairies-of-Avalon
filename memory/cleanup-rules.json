{
  "preserveGlobs": [
    "asset/**",
    "memory/**",
    "pages/**",
    ".github/workflows/**",
    ".github/labeler.yml"
  ],
  "deleteIf": [
    { "glob": "**/*.tmp" },
    { "glob": "**/*~" },
    { "glob": "**/.DS_Store" },
    { "glob": "**/Thumbs.db" },
    { "glob": "**/__MACOSX/**" }
  ],
  "duplicateHashPolicy": "delete-all-but-largest"
}