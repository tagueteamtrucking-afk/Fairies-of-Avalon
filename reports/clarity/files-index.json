iptions\"></textarea>\n    <div style=\"margin-top:8px;display:flex;gap:12px;flex-wrap:wrap;\">\n      <label>Duration per scene (s): <input id=\"dur\" type=\"number\" value=\"3\" min=\"1\" max=\"15\" class=\"btn\" style=\"width:64px\"></label>\n      <label>Caption position: \n        <select id=\"capPos\" class=\"btn\">\n          <option value=\"bottom\" selected>Bottom</option>\n          <option value=\"middle\">Middle</option>\n          <option value=\"top\">Top</option>\n        </select>\n      </label>\n    </div>\n    <h2>Backgrounds</h2>\n    <p style=\"opacity:.7\">Click to choose (or upload a video above):</p>\n    <div id=\"walls\" class=\"grid\"></div>\n  </div>\n</div>\n<script type=\"module\">\nconst W = 360, H = 640;\nconst c = document.getElementById('c'); const g = c.getContext('2d');\nconst playBtn = document.getElementById('play');\nconst recBtn  = document.getElementById('rec');\nconst dl      = document.getElementById('dl');\nconst script  = document.getElementById('script');"
