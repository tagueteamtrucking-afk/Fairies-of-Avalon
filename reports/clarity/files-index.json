    "preview": "name: Carol — Extract Shopping (from plan)\non:\n  workflow_dispatch:\n    inputs:\n      plan_path:\n        description: \"Path to plan JSON to copy and extract\"\n        required: true\n        default: \"pages/apps/carol/plans/twoperson-2wk-unique-20251015T022300Z.json\"\npermissions:\n  contents: write\njobs:\n  extract:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Ensure pwsh and copy plan to merged alias\n        shell: pwsh\n        run: |\n          $plan = \"${{ github.event.inputs.plan_path }}\"\n          if(!(Test-Path $plan)){ throw \"Plan not found: $plan\" }\n          $merged = \"pages/apps/carol/plans/twoperson-2wk-merged.json\"\n          Copy-Item -Force $plan $merged\n      - name: Run Carol-Extract-Shopping-v3.ps1\n        shell: pwsh\n        run: |\n          ./scripts/Carol-Extract-Shopping-v3.ps1 -PlanFile \"pages/apps/carol/plans/twoperson-2wk-merged.json\"\n      - name: Commit artifacts\n        shell: pwsh\n        run: |\n          git config user.name \"github-actions\"\n          git config user.email \"github-actions@users.noreply.github.com\"\n          git add pages/apps/carol/plans/shopping-extracted.json pages/apps/carol/plans/shopping-quantized.json || $true\n          git commit -m \"Carol: refresh shopping list from plan\" || echo \"No changes\"\n          git push\n"
