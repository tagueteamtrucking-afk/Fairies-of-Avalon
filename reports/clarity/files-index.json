    "preview": "name: Carol — Refresh Shopping (direct commit)\n\non:\n  workflow_dispatch:\n    inputs:\n      plan_path:\n        description: \"Path to the plan JSON to use\"\n        required: false\n        default: \"pages/apps/carol/plans/twoperson-2wk-unique-20251015T022300Z.json\"\n\npermissions:\n  contents: write\n\njobs:\n  build-shopping:\n    runs-on: ubuntu-latest\n    defaults:\n      run:\n        shell: pwsh\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Verify plan & stage merged plan\n        run: |\n          $plan = \"${{ github.event.inputs.plan_path }}\"\n          if (-not $plan) {{ $plan = \"pages/apps/carol/plans/twoperson-2wk-unique-20251015T022300Z.json\" }}\n          if (-not (Test-Path $plan)) {{ throw \"Plan not found: $plan\" }}\n          New-Item -ItemType Directory -Force -Path \"pages/apps/carol/plans\" | Out-Null\n          Copy-Item $plan \"pages/apps/carol/plans/twoperson-2wk-merged.json\" -Force\n          Write-Host \"Using plan: $plan\"\n\n      - name: Extract shopping (v3)\n        run: |\n          ./scripts/Carol-Extract-Shopping-v3.ps1\n\n      - name: Commit & push shopping outputs\n        run: |\n          git config user.name  \"github-actions[bot]\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          git add pages/apps/carol/plans/shopping-quantized.json\n          git add pages/apps/carol/plans/shopping-extracted.json\n          if (git diff --staged --quiet) {{ \n            Write-Host \"No shopping changes to commit.\"\n          }} else {{\n            git commit -m \"Carol: refresh shopping list from ${{ github.event.inputs.plan_path }}\"\n            git push\n          }}"
  },
