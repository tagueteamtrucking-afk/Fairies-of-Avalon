    "preview": "name: Repo Vision (index + site map)\n\non:\n  push:\n    branches: [ main ]\n  schedule:\n    - cron: \"17 3 * * *\"\n  workflow_dispatch: {}\n\npermissions:\n  contents: write\n\njobs:\n  index:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Build repo index and site map\n        run: |\n          set -e\n          mkdir -p memory\n          node - <<'JS'\n          const fs = require('fs');\n          const path = require('path');\n\n          function walk(dir, acc=[], root=dir) {\n            for (const e of fs.readdirSync(dir, {withFileTypes:true})) {\n              const p = path.join(dir, e.name);\n              if (e.isDirectory()) {\n                if (['.git','node_modules','.cache','.vercel','.next'].includes(e.name)) continue;\n                acc = walk(p, acc, root);\n              } else {\n                const rel = path.relative(root, p).replace(/\\\\/g,'/');\n                const stat = fs.statSync(p);\n                const hash = require('crypto').createHash('md5').update(fs.readFileSync(p)).digest('hex');\n                const purpose =\n                  rel.startsWith('pages/') ? 'site-page' :\n                  rel.startsWith('asset/') ? 'asset' :\n                  rel.startsWith('.github/workflows/') ? 'workflow' :\n                  rel.startsWith('scripts/') ? 'script' : 'misc';\n                acc.push({ path: rel, bytes: stat.size, hash, purpose });\n              }\n            }\n            return acc;\n          }\n\n          const all = walk(process.cwd());\n          fs.writeFileSync('memory/file-index.json', JSON.stringify({\n            generated: new Date().toISOString(),\n            count: all.length,\n            files: all\n          }, null, 2));\n\n          const pages = all.filter(f => f.path.startsWith('pages/') && f.path.endsWith('.html'))\n                           .map(f => f.path.replace(/^pages\\//,'/pages/'));\n          const entry = fs.existsSync('index.html') ? ['/index.html'] : [];\n          const assets = all.filter(f => f.path.startsWith('asset/')).map(f=>'/'+f.path);\n          let importmap = null;\n          try { importmap = JSON.parse(fs.readFileSync('importmap.json','utf8')); } catch {}"
  },
