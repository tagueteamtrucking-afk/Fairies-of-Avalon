    ],
    "preview": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Nina — 3D Buttons (demo)</title>\n<style>html,body{margin:0;height:100%;background:#0b1220;color:#e5e7eb;font-family:system-ui,Segoe UI,Roboto}canvas{display:block}#hud{position:fixed;left:12px;top:12px;background:rgba(15,23,42,.85);padding:10px;border-radius:12px;border:1px solid #172033}</style>\n</head><body>\n<div id=\"hud\">Click a 3D button to open its room.</div>\n<canvas id=\"c\"></canvas>\n<script src=\"https://unpkg.com/three@0.158.0/build/three.min.js\"></script>\n<script>\nconst W =  window.innerWidth, H = window.innerHeight;\nconst renderer = new THREE.WebGLRenderer({canvas:document.getElementById('c'),antialias:true});\nrenderer.setSize(W,H); const scene = new THREE.Scene(); scene.background = new THREE.Color(0x0b1220);\nconst camera = new THREE.PerspectiveCamera(60, W/H, 0.1, 100); camera.position.set(0,1.5,4);\nconst light = new THREE.DirectionalLight(0xffffff,1.0); light.position.set(1,2,2); scene.add(light); scene.add(new THREE.AmbientLight(0xffffff,0.35));\n\nconst registry = [\n  {id:'alexandria', name:'Library', href:'/pages/apps/alexandria/index.html', shape:'book'},\n  {id:'tracy', name:'Atelier', href:'/pages/apps/tracy/index.html', shape:'easel'},\n  {id:'nina', name:'Lab', href:'/pages/apps/nina/index.html', shape:'orb'},\n  {id:'charlotte', name:'Relay', href:'/pages/apps/charlotte/index.html', shape:'tower'},\n  {id:'stella', name:'Observatory', href:'/pages/apps/stella/index.html', shape:'dome'},\n  {id:'jem', name:'Dojo', href:'/pages/apps/jem/index.html', shape:'pillar'},\n  {id:'carol', name:'Bistro', href:'/pages/apps/carol/index.html', shape:'plate'},\n  {id:'abbey', name:'Vault', href:'/pages/apps/abbey/index.html', shape:'vault'}\n];\n\nfunction makeButton(item, idx){\n  let geo, mat = new THREE.MeshStandardMaterial({metalness:0.2, roughness:0.5});\n  switch(item.shape){\n    case 'book': geo = new THREE.BoxGeometry(1.2,0.2,0.8); break;\n    case 'easel': geo = new THREE.ConeGeometry(0.6,1.0,5); break;\n    case 'orb': geo = new THREE.SphereGeometry(0.55, 32, 24); break;\n    case 'tower': geo = new THREE.CylinderGeometry(0.35,0.35,1.4,24); break;\n    case 'dome': geo = new THREE.SphereGeometry(0.7, 32, 24, 0, Math.PI*2, 0, Math.PI/2); break;\n    case 'pillar': geo = new THREE.CapsuleGeometry(0.25,0.8,8,16); break;\n    case 'plate': geo = new THREE.TorusGeometry(0.6,0.08,18,48); break;\n    case 'vault': geo = new THREE.TorusKnotGeometry(0.35,0.12,80,12); break;\n    default: geo = new THREE.BoxGeometry(1,1,1);\n  }\n  const mesh = new THREE.Mesh(geo, mat.clone());\n  mesh.position.set((idx%4 - 1.5)*1.6, 0.7 - Math.floor(idx/4)*1.6, 0);\n  mesh.userData = item;\n  scene.add(mesh);\n  return mesh;\n}\n\nconst meshes = registry.map(makeButton);\nconst raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2();\nwindow.addEventListener('click', (e)=>{\n  mouse.x = (e.clientX / W) * 2 - 1;\n  mouse.y = -(e.clientY / H) * 2 + 1;\n  raycaster.setFromCamera(mouse, camera);\n  const hit = raycaster.intersectObjects(meshes)[0];\n  if(hit){ const {href} = hit.object.userData; window.location.href = href; }\n});\nfunction animate(){ requestAnimationFrame(animate); meshes.forEach(m=>{ m.rotation.y += 0.01; }); renderer.render(scene,camera); }\nanimate();\n</script>\n</body></html>"
  },
