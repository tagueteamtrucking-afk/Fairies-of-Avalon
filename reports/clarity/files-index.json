    "preview": "name: Crown of Clarity - Digest (issues)\non:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  actions: read\n  issues: write\n\njobs:\n  digest:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Repo Digest Issue\n        uses: actions/github-script@v7\n        with:\n          script: |\n            const fs = require('fs');\n            const owner = context.repo.owner, repo = context.repo.repo;\n            let arr = null;\n            try { arr = JSON.parse(fs.readFileSync('reports/clarity/catalog.json','utf8')); } catch (e) {}\n            const files = Array.isArray(arr) ? arr : (arr && arr.files ? arr.files : []);\n            const total = files.length;\n            const size = files.reduce((a,b)=>a+(b.bytes||0),0);\n            const mb = (size/1048576).toFixed(2);\n            const body = [\n              '## Crown of Clarity - Repo Digest',\n              'Generated: ' + new Date().toISOString(),\n              '',\n              '- Total files: **' + total + '**',\n              '- Total size: **' + mb + ' MB**',\n              '- Catalog: reports/clarity/catalog.json'\n            ].join('\\n');\n            const title = 'Crown of Clarity - Repo Digest';\n            const issues = (await github.rest.issues.listForRepo({owner, repo, state:'open'})).data;\n            const existing = issues.find(i => i.title === title);\n            if (existing) {\n              await github.rest.issues.update({owner, repo, issue_number: existing.number, body});\n            } else {\n              await github.rest.issues.create({owner, repo, title, body});\n            }\n"
  },
