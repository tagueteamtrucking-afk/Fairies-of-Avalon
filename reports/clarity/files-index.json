    "preview": "name: Carol - Ensure Plan (create 14d if missing)\non: { workflow_dispatch: {} }\npermissions: { contents: write }\njobs:\n  ensure:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Ensure baseline 14-day plan exists\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p pages/apps/carol/plans pages/apps/carol/templates\n          # only create if no mealplan-*.json present\n          if ls pages/apps/carol/plans/mealplan-*.json >/dev/null 2>&1; then\n            echo \"Mealplan exists; skipping seed.\"\n          else\n            cp pages/apps/carol/templates/mealplan-balanced-14d.json \"pages/apps/carol/plans/mealplan-balanced-$(date -u +%Y%m%dT%H%M%SZ).json\"\n          fi\n      - name: Commit plan if created\n        shell: bash\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git add pages/apps/carol/plans/mealplan-*.json || true\n          if git diff --cached --quiet; then echo \"No new plan\"; else git commit -m \"feat(carol): seed 14d plan (balanced)\" && git push; fi\n"
  },
