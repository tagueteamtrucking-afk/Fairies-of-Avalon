    "preview": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Stella — On‑Demand Sound</title>\n<link rel=\"stylesheet\" href=\"stella.css\">\n</head><body>\n<header><h1>Stella — On‑Demand Sound</h1><p class=\"sub\">Tap a mood. Tap again to stop. Headphones recommended for binaural‑style modes.<br><small>Supportive & non‑clinical. Not medical advice.</small></p></header>\n<main>\n  <section class=\"grid\">\n    <button class=\"tile\" data-mode=\"focus\">🎯 Focus</button>\n    <button class=\"tile\" data-mode=\"calm\">🌿 Calm</button>\n    <button class=\"tile\" data-mode=\"relax\">🫶 Relax</button>\n    <button class=\"tile\" data-mode=\"energize\">⚡ Energize</button>\n    <button class=\"tile\" data-mode=\"winddown\">🌙 Wind‑down</button>\n    <button class=\"tile\" data-mode=\"silence\">🤫 Silence</button>\n  </section>\n  <section class=\"ctrls\">\n    <label>Master volume <input id=\"vol\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.35\"></label>\n    <label>Duration (min) <input id=\"mins\" type=\"number\" min=\"1\" max=\"120\" value=\"20\"></label>\n    <button id=\"stop\">Stop</button>\n  </section>\n  <section class=\"log\" id=\"log\"></section>\n</main>\n<footer><small>v1.8.1 — WebAudio only; no network required.</small></footer>\n<script src=\"stella.js\"></script>\n</body></html>\n"
  },
