    "preview": "name: Sorcha - Faceless Video Storyboards\non: { workflow_dispatch: {} }\npermissions: { contents: write }\njobs:\n  storyboard:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Build storyboard seed from latest Carol plan\n        shell: pwsh\n        run: |\n          $ErrorActionPreference=\"Stop\"\n          $root = $env:GITHUB_WORKSPACE\n          $plans = Join-Path $root \"pages/apps/carol/plans\"\n          $outDir = Join-Path $root \"pages/apps/sorcha/storyboards\"\n          if(-not (Test-Path -LiteralPath $plans)){ Write-Error \"Carol plans missing\"; exit 1 }\n          $latest = Get-ChildItem -LiteralPath $plans -File -Filter \"mealplan-*.json\" | Sort-Object LastWriteTime -Descending | Select-Object -First 1\n          if($null -eq $latest){ Write-Error \"No mealplan json found\"; exit 1 }\n          $plan = Get-Content -Raw -LiteralPath $latest.FullName | ConvertFrom-Json\n          $days = @($plan.menu.days); if(-not $days){ $days = @($plan.days) }\n          $scenes = @()\n          for($i=0;$i -lt $days.Count;$i++){\n            $items = @()\n            $d = $days[$i]\n            if($d.snacks){ $items = $d.snacks } elseif($d.items){ $items = $d.items } else { $items = @() }\n            $scenes += @{\n              day = $i+1\n              topic = \"What I ate (DASH style)\"\n              broll = @(\"prep hands\",\"airfryer closeup\",\"mixing bowl\",\"text overlay\")\n              script = \"Day \"+($i+1)+\" choices: \"+($items -join \"; \")\n            }\n          }\n          $doc = @{ updated=(Get-Date).ToUniversalTime().ToString(\"s\")+'Z'; source=$latest.Name; scenes=$scenes }\n          if(-not (Test-Path -LiteralPath $outDir)){ New-Item -ItemType Directory -Force -Path $outDir | Out-Null }\n          $outPath = Join-Path $outDir (\"storyboard-\"+(Get-Date -Format \"yyyyMMddTHHmmssZ\")+\".json\")\n          [IO.File]::WriteAllText($outPath, ($doc | ConvertTo-Json -Depth 6), [Text.Encoding]::UTF8)\n      - name: Commit storyboard\n        shell: bash\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git add pages/apps/sorcha/storyboards/*.json || true\n          if git diff --cached --quiet; then echo \"No changes\"; else git commit -m \"feat(sorcha): storyboard from mealplan\" && git push; fi\n"
  },
