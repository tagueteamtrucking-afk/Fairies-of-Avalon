    "preview": "<!doctype html><html lang=\"en\"><head>\n<meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Jem — Program Viewer (Week‑1)</title>\n<link rel=\"stylesheet\" href=\"/pages/apps/_shared/ui-lite.css\">\n</head><body><div class=\"wrap\">\n<div class=\"nav\">\n  <a class=\"btn\" href=\"/pages/apps/_city/castle-town.html\">🗺️ Castle‑Town</a>\n  <a class=\"btn\" href=\"/pages/apps/jem/evaluate.html\">🧪 Evaluation</a>\n</div>\n<h1>📋 Jem — Week‑1 Plan</h1>\n<div class=\"panel\">\n  <h3>Load your evaluation JSON</h3>\n  <input type=\"file\" id=\"file\" accept=\"application/json\">\n</div>\n<div class=\"panel\" id=\"px\"></div>\n<div class=\"panel\">\n  <table id=\"plan\"><thead><tr><th>Day</th><th>Warm‑up</th><th>Strength/Mobility</th><th>Cardio</th><th>Cool‑down</th><th>Log (what I did)</th></tr></thead><tbody></tbody></table>\n</div>\n<div class=\"panel\">\n  <button class=\"btn\" id=\"export\">⬇️ Export Progress JSON</button>\n</div>\n<script>\nlet intake=null, progress=[];\nfunction read(f){ return new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(r.result); r.onerror=rej; r.readAsText(f); })}\nfunction level(sts, pu, plank){ let score=0; if(sts>=15)score++; if(pu.reps>=10)score++; if(plank>=30)score++; return score } // 0=novice,1=base,2=good\nfunction prog(intake){\n  const p=intake; const lvl=level(p.tests.sts30, p.tests.pushups, p.tests.plank_sec);\n  const knee = (p.goals.pain||0)>=4;\n  const equip = new Set(p.equipment||[]);\n  const days=[];\n  for(let d=1; d<=7; d++){\n    const warm = \"3–5 min easy march in place + shoulder rolls + ankle circles\";\n    const strength = [\n      knee? \"Sit-to-Stand (chair) 3×8 (hands free if possible)\":\"Sit-to-Stand 3×10\",\n      \"Wall Push-ups 3×8 (or Knees 2×10)\",\n      \"Bird-dog 3×6/side (slow)\",\n      \"Glute bridge 3×10\",\n      \"Standing calf stretch 2×30s/side\",\n      \"Hamstring stretch 2×30s/side\"\n    ];\n    if(p.tests.wallsit_sec<30) strength.push(\"Wall-sit holds 3×20–30s\");\n    if(p.tests.plank_sec<20) strength.push(\"Modified plank (knees) 3×15–20s\");\n    if(equip.has('bands')) strength.push(\"Terminal knee extension (band) 2×12\");\n    const cardio = \"10–15 min low‑impact: brisk walk, step‑march or gentle shadow‑boxing (RPE 3–4). Monitor how you feel.\";\n    const cool = \"2–3 min slow walk + breath work (4‑2‑6)\";\n    days.push({day:d,warm,strength,cardio,cool,log:{}});\n  }\n  return days;\n}\nfunction renderPlan(days){\n  const tb=document.querySelector(\"#plan tbody\"); tb.innerHTML=\"\"; progress = days.map(d=>({day:d.day, did:{}}));\n  days.forEach((d,i)=>{\n    const tr=document.createElement('tr');\n    const s = \"<ul>\"+d.strength.map(x=>\"<li>\"+x+\"</li>\").join(\"\")+\"</ul>\";\n    tr.innerHTML = `<td class='k'>Day ${d.day}</td><td>${d.warm}</td><td>${s}</td><td>${d.cardio}</td><td>${d.cool}</td>\n      <td><textarea data-i=\"${i}\" rows=\"3\" placeholder=\"What I did, RPE, time...\"></textarea></td>`;\n    tb.appendChild(tr);\n  });\n  tb.querySelectorAll(\"textarea\").forEach(t=>t.addEventListener('input',e=>{\n    const i=+e.target.dataset.i; progress[i].did.notes = e.target.value;"
  },
