    "preview": "body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,sans-serif;margin:0;padding:0;background:#0e1220;color:#e8ecff}\nheader{padding:16px 20px;border-bottom:1px solid #2b3250;background:#121732}\nh1{margin:0;font-size:20px}\n.sub{opacity:.8;margin:6px 0 0 0}\n.pane{display:flex;gap:16px;align-items:center;padding:12px 20px;border-bottom:1px solid #2b3250}\n.pane > div{display:flex;gap:10px;align-items:center}\nbutton{border:1px solid #4050a0;background:#1a2458;color:#e8ecff;padding:8px 12px;border-radius:8px}\nselect,input{background:#0f1530;border:1px solid #334; color:#e8ecff;padding:6px 8px;border-radius:6px}\n#today{padding:16px 20px}\n.block{border:1px solid #2b3250;background:#121732;border-radius:10px;margin:12px 0;padding:12px}\n.block h3{margin:0 0 8px 0;font-size:16px}\n.row{display:flex;gap:12px;flex-wrap:wrap;margin:6px 0}\n.badge{border:1px solid #4050a0;padding:4px 8px;border-radius:999px;font-size:12px}\n.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;padding:16px 20px}\n.card{border:1px solid #2b3250;background:#121732;border-radius:10px;padding:12px}\n.note{opacity:.75;padding:12px 20px}\n"
