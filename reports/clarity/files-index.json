    "preview": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Carol — Two‑Week Plan</title>\n<style>\n:root{--bg:#0b0f17;--ink:#e5e7eb;--line:#172033;--card:#0f172a;--accent:#60a5fa}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui}\nheader,main{padding:14px}h1{margin:0 0 6px 0}\n.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}\n.card{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:12px}\n.small{font-size:12px;color:#94a3b8}\n.table{width:100%;border-collapse:collapse} .table td,.table th{border-bottom:1px solid #172033;padding:6px;vertical-align:top}\n.btn{display:inline-block;padding:8px 10px;border:1px solid #334155;border-radius:10px;text-decoration:none;color:var(--ink);background:#0b1220;margin-right:6px}\n.btn:hover{border-color:#3b82f6;color:white}\npre.wrap{white-space:pre-wrap}\n.warn{background:#33281a;color:#fcd34d;border:1px solid #6b4a2f;padding:8px;border-radius:8px;margin:8px 0}\nsummary{cursor:pointer}\nkbd{background:#0b1220;border:1px solid #334155;border-radius:6px;padding:2px 6px}\n</style></head><body>\n<header>\n  <h1>Carol — Two‑Week Plan</h1>\n  <div class=\"small\">Read‑only plan. Export TXT or Print/PDF. To regenerate, run Carol Action(s) in GitHub.</div>\n  <div id=\"meta\" class=\"small\"></div>\n  <div style=\"margin-top:8px\">\n    <a class=\"btn\" id=\"open-json\" target=\"_blank\">Open Plan JSON</a>\n    <a class=\"btn\" id=\"open-quant\" target=\"_blank\">Open Quantized Shopping</a>\n    <button class=\"btn\" id=\"download-list\">Download Shopping List (.txt)</button>\n    <button class=\"btn\" onclick=\"window.print()\">Print / Save PDF</button>\n  </div>\n</header>\n<main>\n  <div id=\"troubles\" class=\"warn\" style=\"display:none\"></div>\n  <div class=\"grid\" id=\"days\"></div>\n  <div class=\"card\">\n    <h3>Shopping List (2 weeks)</h3>\n    <pre id=\"shop\" class=\"wrap\"></pre>\n  </div>\n  <div class=\"card\">\n    <h3>Buy by Packages (US)</h3>\n    <div class=\"small\">Based on common retail sizes; approximate for dry goods.</div>\n    <pre id=\"shopPkg\" class=\"wrap\"></pre>\n  </div>\n</main>\n<script>\n(async()=>{\n  const troubles=document.getElementById('troubles');\n  function showTrouble(msg){ troubles.textContent=msg; troubles.style.display='block'; }\n  async function j(p){ const r=await fetch(p); if(!r.ok) throw new Error('HTTP '+r.status+' @ '+p); return r.json(); }\n  function fracStr(n){\n    const m = Math.round(n*24); const whole = Math.floor(m/24); const rem = m - whole*24;\n    function simp(a,b){ const g=(x,y)=>y?g(y,x%y):x; const g0=g(a,b); return [a/g0,b/g0]; }\n    let s=''; if(whole>0) s+=whole;\n    if(rem>0){ const [a,b]=simp(rem,24); s+=(s? ' ':'')+a+'/'+b; }\n    if(!s) s='0'; return s;\n  }\n  function asKitchen(q,u){\n    const map={tsp:1, tbsp:3, cup:48}; // tsp base\n    if(u==='tsp'||u==='tbsp'||u==='cup'){ const tsp=q*(u==='tsp'?1:u==='tbsp'?3:48); // normalize\n      if(tsp%48===0) return (tsp/48)+' cup';\n      if(tsp%3===0 && tsp<48) return (tsp/3)+' tbsp';\n      return fracStr(tsp/48)+' cup';"
  },
