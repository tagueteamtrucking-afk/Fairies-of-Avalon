    "preview": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Fairy–Function Matrix</title>\n<link rel=\"stylesheet\" href=\"/pages/apps/common/style.css\">\n</head><body><div class=\"wrap\">\n<h2>🧭 Fairy–Function Matrix (Evolution)</h2>\n<p class=\"sub\">Live snapshot derived from memory/owners.json and evolution rules.</p>\n<table style=\"width:100%;border-collapse:collapse\">\n  <thead><tr><th style=\"text-align:left;padding:8px\">Fairy</th><th style=\"text-align:left;padding:8px\">Merged From</th><th style=\"text-align:left;padding:8px\">Owns</th><th style=\"text-align:left;padding:8px\">Relations</th></tr></thead>\n  <tbody id=\"rows\"></tbody>\n</table>\n<p style=\"margin-top:12px\"><a href=\"/index.html\">⬅ Home</a></p>\n<script type=\"module\">\nconst rows = document.getElementById('rows');\nconst data = await fetch('/memory/fairy_function_matrix.json').then(r=>r.json());\nfor(const [name, s] of Object.entries(data.fairies)){\n  const tr = document.createElement('tr');\n  const owns = (s.owns||[]).join(', ');\n  const merged = (s.merged_from||[]).join(', ');\n  const rel = [s.twin_with?`twin:${s.twin_with}`:'', s.paired_with?`pair:${s.paired_with}`:''].filter(Boolean).join(' | ');\n  tr.innerHTML = `<td style=\\\"padding:8px\\\"><strong>${name}</strong></td><td style=\\\"padding:8px\\\">${merged||'-'}</td><td style=\\\"padding:8px\\\">${owns||'-'}</td><td style=\\\"padding:8px\\\">${rel||'-'}</td>`;\n  rows.appendChild(tr);\n}\n</script>\n</div></body></html>\n"
