    "preview": "/* Avalon City */\n:root{\n  --bg:#0b0f1a; --fg:#e6ecff; --muted:#9fb3d1; --frame:rgba(255,255,255,.08);\n  --card:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));\n}\n*{box-sizing:border-box}\nhtml,body{height:100%; margin:0}\nbody{background:radial-gradient(1000px 700px at 70% -10%,#1a2440 0%,#0b0f1a 60%,#060913 100%); color:var(--fg); font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,'Helvetica Neue',Arial}\n\n.topbar{position:sticky; top:0; display:flex; align-items:center; justify-content:space-between; padding:14px 16px; background:rgba(6,9,19,.7); backdrop-filter:blur(6px); border-bottom:1px solid var(--frame)}\n.brand{font-weight:700}\n.actions{display:flex; gap:10px}\n.act{color:var(--fg); text-decoration:none; background:rgba(255,255,255,.06); padding:10px 12px; border-radius:10px; border:1px solid var(--frame)}\n\n.grid{display:grid; gap:16px; padding:18px; grid-template-columns:repeat(2,minmax(0,1fr))}\n@media(min-width:720px){ .grid{grid-template-columns:repeat(3,minmax(0,1fr))} }\n.tile{display:block; text-decoration:none; color:var(--fg); background:var(--card); border:1px solid var(--frame); border-radius:14px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,.3)}\n.tile-img{aspect-ratio:16/9; background-size:cover; background-position:center; filter:saturate(.9) contrast(1.05)}\n.tile-meta{padding:12px 14px; display:flex; flex-direction:column; gap:4px}\n.tile-meta b{font-size:16px}\n.tile-meta span{font-size:13px; color:var(--muted)}\n\n/* Image themes (replace with photos later) */\n.tile-lib{background-image:linear-gradient(135deg,#2a355a,#11182b)}\n.tile-cathedral{background-image:linear-gradient(135deg,#503c6e,#131129)}\n.tile-dojo{background-image:linear-gradient(135deg,#465a2a,#121a0f)}\n.tile-bistro{background-image:linear-gradient(135deg,#5a2a35,#1a0f14)}\n.tile-observatory{background-image:linear-gradient(135deg,#20375a,#0d1422)}\n.tile-lab{background-image:linear-gradient(135deg,#2a5a50,#0f1a18)}\n.tile-relay{background-image:linear-gradient(135deg,#5a4a2a,#1a160d)}\n.tile-vault{background-image:linear-gradient(135deg,#414040,#0f0f0f)}\n.tile-palace{background-image:linear-gradient(135deg,#5a2a5a,#1a0f1a)}\n.tile-mansion{background-image:linear-gradient(135deg,#3a4a5a,#0f141a)}\n"
