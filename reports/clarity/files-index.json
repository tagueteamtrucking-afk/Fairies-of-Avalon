    "preview": "name: Crown of Clarity — Content Scan (purpose + linkage)\non:\n  push:\n    branches:\n      - main\n  workflow_dispatch:\n\npermissions:\n  contents: write\n  actions: read\n  issues: write\n  pull-requests: write\n\njobs:\n  content:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n\n      - name: Analyze repo content\n        run: node scripts/clarity/analyze.mjs\n\n      - name: Upload content analysis\n        uses: actions/upload-artifact@v4\n        with:\n          name: clarity-content\n          path: |\n            reports/clarity/files-index.json\n            reports/clarity/workflows-map.json\n            reports/clarity/pages-map.json\n            reports/clarity/workers-map.json\n\n      - name: PR — Commit content analysis\n        uses: peter-evans/create-pull-request@v6\n        with:\n          commit-message: \"clarity(content): update content analysis\"\n          title: \"clarity(content): update content analysis\"\n          branch: \"ci/clarity-content-${{ github.run_id }}\"\n          base: \"${{ github.ref_name }}\"\n          add-paths: |\n            reports/clarity/files-index.json\n            reports/clarity/workflows-map.json\n            reports/clarity/pages-map.json\n            reports/clarity/workers-map.json\n"
