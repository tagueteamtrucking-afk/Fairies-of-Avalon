    "preview": "<!doctype html>\n<html><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>Access Setup</title>\n<style>\n  body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Inter,Arial,sans-serif;background:#0b0b10;color:#f2f4f8;margin:0}\n  main{max-width:700px;margin:0 auto;padding:24px}\n  input,button{padding:10px;border-radius:8px;border:1px solid #1b1b26;background:#12121a;color:#f2f4f8}\n  .row{display:flex;gap:8px;align-items:center}\n  .mut{color:#aab2c0}\n</style>\n<main>\n  <h1>Access Setup</h1>\n  <p class=\"mut\">Enter PIN to set your role. 1775 → dev (Ray), 4406 → user (Blanca).</p>\n  <div class=\"row\">\n    <input id=\"pin\" placeholder=\"Enter PIN\" inputmode=\"numeric\" />\n    <button onclick=\"setRole()\">Set</button>\n  </div>\n  <p id=\"out\" class=\"mut\"></p>\n</main>\n<script>\nfunction setRole(){\n  const v = (document.getElementById('pin').value||'').trim();\n  let role = '';\n  if(v==='1775') role='dev';\n  else if(v==='4406') role='user';\n  else role='user';\n  localStorage.setItem('avalon.role', role);\n  document.getElementById('out').textContent = 'Role set to '+role+'.';\n}\n</script>\n</html>"
