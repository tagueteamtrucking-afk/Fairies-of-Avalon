    "preview": "<!doctype html><html lang=\"en\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Jem — Week 1 Viewer & Progress</title>\n<style>\n:root{--bg:#0b0f17;--ink:#e5e7eb;--line:#172033;--card:#0f172a;--accent:#60a5fa;--ok:#16a34a;--warn:#f59e0b;--bad:#ef4444}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,Segoe UI,Roboto}\nheader,main{padding:14px}h1{margin:0 0 8px 0}\n.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}\n.card{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:12px}\nsmall{color:#94a3b8}.muted{color:#94a3b8}\n.btn{display:inline-block;padding:8px 10px;border:1px solid #334155;border-radius:10px;text-decoration:none;color:var(--ink);background:#0b1220;margin-right:6px;cursor:pointer}\n.btn:hover{border-color:#3b82f6;color:white}\ninput,select,textarea{width:100%;padding:8px;background:#0b1220;border:1px solid #334155;border-radius:8px;color:var(--ink)}\nlabel{display:block;font-size:13px;margin:6px 0 4px}\nhr{border:0;border-top:1px solid var(--line);margin:10px 0}\n.badge{display:inline-flex;align-items:center;gap:6px;border:1px solid #334155;background:#0b1220;border-radius:999px;padding:4px 10px;margin-left:8px}\n.badge.ok{border-color:#1f4e2e;color:#bbf7d0}.badge.fail{border-color:#5a1f26;color:#fecaca}\n.table{width:100%;border-collapse:collapse}.table td,.table th{border-bottom:1px solid #172033;padding:6px;vertical-align:top}\n.notice{background:#1d2a20;border:1px solid #2a3d2e;color:#d1fae5;border-radius:8px;padding:8px;margin:8px 0}\n.warn{background:#33281a;border:1px solid #6b4a2f;color:#fde68a;border-radius:8px;padding:8px;margin:8px 0}\n.row{display:flex;gap:8px;flex-wrap:wrap}\n.row>*{flex:1 1 140px}\ncode.k{background:#0b1220;border:1px solid #334155;border-radius:6px;padding:2px 6px}\n</style></head><body>\n<header>\n  <h1>Jem — Week 1 Viewer & Progress\n    <span id=\"planBadge\" class=\"badge\">Plan: …</span>\n    <span id=\"bioBadge\" class=\"badge\">Biometrics: …</span>\n  </h1>\n  <div class=\"muted\">Week 1 is <b>evaluation</b>. Log your tests and what you actually did; export a progress file you can upload to the repo. Jem will suggest a Week‑2 progression based on the results.</div>\n  <div class=\"row\" style=\"margin-top:8px\">\n    <select id=\"personSel\"></select>\n    <button class=\"btn\" id=\"loadBtn\">Load Plan</button>\n    <button class=\"btn\" id=\"exportProg\">Export Progress (.json)</button>\n    <button class=\"btn\" id=\"downloadW2\">Download Week‑2 Suggestion (.json)</button>\n    <a class=\"btn\" id=\"openPrograms\" target=\"_blank\">Open programs folder</a>\n  </div>\n</header>\n<main class=\"grid\">\n  <div class=\"card\">\n    <h3>Week 1 — Tests</h3>\n    <div class=\"muted\">Complete once this week; use pain‑free range. Stop on sharp pain.</div>\n    <div class=\"row\">\n      <div>\n        <label>Sit‑to‑Stand (30s) — count</label>\n        <input id=\"t_s2s\" type=\"number\" min=\"0\" placeholder=\"e.g., 10\">\n      </div>\n      <div>\n        <label>Plank hold — seconds</label>\n        <input id=\"t_plank\" type=\"number\" min=\"0\" placeholder=\"e.g., 30\">\n      </div>\n      <div>\n        <label>Wall sit — seconds</label>\n        <input id=\"t_wallsit\" type=\"number\" min=\"0\" placeholder=\"e.g., 30\">\n      </div>\n      <div>\n        <label>Low step‑ups — RPE (1–10)</label>\n        <input id=\"t_stepupeffort\" type=\"number\" min=\"1\" max=\"10\" placeholder=\"e.g., 6\">\n      </div>\n    </div>"
