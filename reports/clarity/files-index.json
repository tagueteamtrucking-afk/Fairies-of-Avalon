    "preview": "name: Importmap Merge (PR-first)\non:\n  workflow_dispatch:\n    inputs:\n      imports_json:\n        description: 'JSON object: keys become importmap.json \"imports\" entries'\n        required: true\npermissions:\n  contents: write\n  pull-requests: write\njobs:\n  merge:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Write incoming JSON to file\n        shell: bash\n        run: |\n          set -euo pipefail\n          printf '%s\\n' '${{ inputs.imports_json }}' > _merge.json\n\n      - name: Merge into importmap.json\n        shell: bash\n        run: |\n          set -euo pipefail\n          if [ ! -f importmap.json ]; then echo '{}' > importmap.json; fi\n          node - <<'NODE'\n          const fs = require('fs');\n          const target = JSON.parse(fs.readFileSync('importmap.json','utf8'));\n          const add = JSON.parse(fs.readFileSync('_merge.json','utf8'));\n          target.imports = Object.assign({}, target.imports || {}, add);\n          fs.writeFileSync('importmap.json', JSON.stringify(target, null, 2) + '\\n');\n          NODE\n\n      - name: Create PR\n        uses: peter-evans/create-pull-request@v6\n        with:\n          commit-message: 'importmap: merge additions'\n          title: 'importmap: merge additions'\n          body: |\n            Automated merge into importmap.json.\n          branch: ci/importmap-merge-${{ github.run_id }}\n          base: ${{ github.ref_name }}\n"
