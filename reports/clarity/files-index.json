    "preview": "name: Pages Preflight (links + importmap)\n\non:\n  pull_request:\n    branches: [ main ]\n    paths:\n      - \"**/*.html\"\n      - \"importmap.json\"\n      - \"pages/**\"\n      - \"asset/**\"\n      - \".github/workflows/pages-preflight.yml\"\n      - \"memory/site-map.json\"\n  workflow_dispatch: {}\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: pages-preflight-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  preflight:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - name: Build site map fallback (if not present)\n        run: |\n          if [ ! -f memory/site-map.json ]; then\n            mkdir -p memory\n            node - <<'JS'\n            const fs = require('fs'), path = require('path');\n            function walk(d, acc=[]){for(const e of fs.readdirSync(d,{withFileTypes:true})){\n              const p=path.join(d,e.name); if(e.isDirectory()){ if(['.git','node_modules','.next','.vercel','.cache'].includes(e.name))continue; walk(p,acc);}\n              else{ acc.push(path.relative(process.cwd(),p).replace(/\\\\/g,'/')); }} return acc; }\n            const files = walk(process.cwd());\n            const pages = files.filter(f=>f.startsWith('pages/') && f.endsWith('.html')).map(f=>'/'+f);\n            const entry = fs.existsSync('index.html')? ['/index.html']:[];\n            const assets = files.filter(f=>f.startsWith('asset/')).map(f=>'/'+f);\n            let importmap=null; try{importmap=JSON.parse(fs.readFileSync('importmap.json','utf8'));}catch{}\n            fs.writeFileSync('memory/site-map.json', JSON.stringify({generated:new Date().toISOString(),entrypoints:entry,pages,assets,importmap},null,2));\n            JS\n          fi\n      - name: Preflight checks (broken links + importmap sanity)\n        id: check\n        run: |\n          node - <<'JS'\n          const fs = require('fs'), path = require('path');\n          const exists = p => fs.existsSync(p) && fs.statSync(p).isFile();\n          const site = JSON.parse(fs.readFileSync('memory/site-map.json','utf8'));\n          const problems = [];\n          let im = site.importmap || null;\n          if (!im) { try { im = JSON.parse(fs.readFileSync('importmap.json','utf8')); } catch {} }\n          const need = ['three','three/addons/'];\n          for (const n of need) if (!im?.imports?.[n]) problems.push(`importmap.json missing \"${n}\"`);\n          if (!im?.imports?.['@pixiv/three-vrm']) problems.push('importmap.json missing \"@pixiv/three-vrm\"');\n          const htmlFiles = new Set([...site.entrypoints.map(s=>s.replace(/^\\//,'')),...site.pages.map(s=>s.replace(/^\\//,''))]);\n          const allFiles = new Set(fs.readdirSync('.',{withFileTypes:true}).flatMap(e=>e.name));\n          function parseLinks(html){const out=[];const rx=/(?:href|src)=[\"']([^\"']+)[\"']/g;let m;while((m=rx.exec(html)))out.push(m[1]);return out;}\n          for(const file of htmlFiles){if(!exists(file)){problems.push(`Missing HTML: ${file}`);continue;}"
