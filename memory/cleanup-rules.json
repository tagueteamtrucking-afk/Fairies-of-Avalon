{
  "preserveGlobs": [
    "asset/models/**",
    "asset/wings/**",
    ".github/workflows/**",
    "memory/**",
    "index.html",
    "pages/_city/**",
    "pages/apps/nina/**",
    "pages/apps/charlotte/**",
    "pages/apps/billie/**",
    "pages/apps/tracy/**",
    "pages/apps/common/**"
  ],
  "deleteIf": [
    {
      "glob": "pages/apps/clarice/**",
      "reason": "merged into Nina (keep only redirect index if present)"
    },
    {
      "glob": "pages/apps/themis/**",
      "reason": "merged into Charlotte (keep only redirect index if present)"
    },
    {
      "glob": "pages/apps/odessa/**",
      "reason": "merged into Billie (keep only redirect index if present)"
    },
    {
      "glob": "pages/apps/sorcha/**",
      "reason": "merged into Billie (keep only redirect index if present)"
    },
    {
      "glob": "**/*.tmp",
      "reason": "temporary file"
    },
    {
      "glob": "**/*~",
      "reason": "editor backup"
    },
    {
      "glob": "**/.DS_Store",
      "reason": "system file"
    },
    {
      "glob": "**/Thumbs.db",
      "reason": "system file"
    },
    {
      "glob": "pages/**",
      "sizeLT": 12,
      "reason": "empty stub page"
    }
  ],
  "duplicateHashPolicy": "delete-all-but-largest"
}