    "preview": "<script>\n(async function(){\n  const holder=document.querySelector('main');\n  try{\n    const r=await fetch('/pages/apps/jem/programs/index.json?cb='+Date.now(),{cache:'no-store'});\n    if(!r.ok){ throw 0; }\n    const j=await r.json();\n    const hasW1=(j.files||[]).some(f=>/week1-.*\\.json$/i.test(f));\n    if(!hasW1){\n      const box=document.createElement('div'); box.className='warn';\n      box.innerHTML=`No Week‑1 plans found. Do this:<ol>\n<li>Open <a href=\"/pages/apps/jem/index.html\" class=\"btn\">Jem Intake</a> and export the intake JSON(s).</li>\n<li>Upload to <code>pages/apps/jem/intake/</code> (main branch).</li>\n<li>Run Actions → <b>Jem — Generate Week 1 Plans</b>, then <b>Deploy GitHub Pages</b>.</li>\n</ol>`;\n      holder.prepend(box);\n    }\n  }catch(e){}\n})();\n</script>"
