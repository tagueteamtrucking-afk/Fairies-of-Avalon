    "preview": "name: Crown of Clarity — Observe (repo + site) on push\non:\n  push:\n    branches:\n      - main\n  workflow_dispatch:\n\npermissions:\n  contents: write\n  actions: read\n  issues: write\n  pull-requests: write\n\njobs:\n  observe:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Install tools\n        run: |\n          sudo apt-get update -y\n          sudo apt-get install -y jq wget zip\n\n      - name: Build file catalog (path, sha256, bytes)\n        run: |\n          git ls-files -z | xargs -0 -I{} bash -lc 'printf \"%s\\t%s\\n\" \"$(stat -c %s \"{}\")\" \"{}\"' > _sizes.tsv\n          git ls-files -z | xargs -0 -I{} bash -lc 'sha256sum \"{}\"' > _sha.tsv\n          awk '{print $2\"\\t\"$1}' _sha.tsv | sort > _sha.sorted\n          sort _sizes.tsv > _sizes.sorted\n          join -t $'\\t' -1 1 -2 2 _sha.sorted _sizes.sorted > _join.tsv\n          jq -Rn '\n            [inputs | split(\"\\n\")[] | select(length>0) | split(\"\\t\")]\n            | map({path: .[0], sha256: .[1], bytes: (.[2]|tonumber)})\n          ' < _join.tsv > _files.json\n          echo '{\"generated\":\"2025-10-31T19:08:34\"}' > _meta.json\n          jq -s '.[0] + {\"files\":.[1]}' _meta.json _files.json > reports_catalog.json\n\n      - name: Create repo snapshot artifact (zip of repo HEAD)\n        run: |\n          mkdir -p snapshot\n          git ls-files -z | xargs -0 -I{} bash -lc 'mkdir -p \"snapshot/$(dirname \"{}\")\"; cp \"{}\" \"snapshot/{}\"' || true\n          (cd snapshot && zip -r ../repo-snapshot.zip .)\n\n      - name: Discover site URLs from index + /pages\n        run: |\n          mkdir -p urls\n          BASE=\"https://fairiesofavalon.com\"\n          echo \"$BASE/index.html\" > urls/seed.txt\n          echo \"$BASE/pages/\" >> urls/seed.txt\n          touch urls/discovered-raw.txt\n          while read -r u; do\n            curl -fsSL \"$u\" | grep -Eoi 'href=[\"'\"'\"'\"]([^\"'\"'\"']+)[\"'\"'\"'\"]' | sed -E 's/^href=[\"'\"'\"'\"]//; s/[\"'\"'\"']$//' >> urls/discovered-raw.txt || true\n          done < urls/seed.txt\n          awk -v B=\"$BASE\" '\n            /^http/ {print $0; next}\n            /^\\// {print B $0; next}\n            {print B\"/\"$0}\n          ' urls/discovered-raw.txt |"
