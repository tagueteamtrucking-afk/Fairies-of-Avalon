s:flex-start; gap:.5rem; }\n.kv .k{ width:90px; color:var(--muted); font-size:.9rem;}\n.kv .v{ flex:1; }\nul.inline{ margin:.25rem 0; padding-left:1.1rem;}\n.notice{\n  margin:1rem; padding:1rem; background:rgba(255,61,61,0.1); border:1px solid #5a1f1f; border-radius:.65rem;"
