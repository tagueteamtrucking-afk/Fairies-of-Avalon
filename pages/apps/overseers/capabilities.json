{
  "ai_core": {
    "version": "0.6.0",
    "status": "operational-core",
    "llm_bridge": {
      "providers": ["openai"],
      "env_keys": ["OPENAI_API_KEY"],
      "model_default": "gpt-4o-mini",
      "dry_run_default": false
    }
  },
  "hub": {
    "path": "/apps/overseers/hub/",
    "features": ["launch", "impersonate", "status", "manifests", "permissions"]
  },
  "queue": {
    "requests_dir": "requests",
    "processed_dir": "processed",
    "known_actions": [
      "asset_audit",
      "importmap_check",
      "memory_snapshot",
      "scaffold_fairies_bundle",
      "create_microapps",
      "build_manifests",
      "permissions_process"
    ]
  },
  "budgets": {
    "initial_shell_kb": 300,
    "initial_requests": 15,
    "vrm_per_file_mb": 40,
    "wallpapers_total": 20
  },
  "notes": [
    "Overseers inherit all functions and can launch/impersonate Fairies via Hub.",
    "Workflows-first. No plaintext secrets; use repo Secrets or external vault refs.",
    "Import map required on module pages for three/three-addons/@pixiv/three-vrm."
  ]
}
