    "preview": "name: Carol — Refresh from Pointer\n\non:\n  workflow_dispatch:\n    inputs:\n      plan_path:\n        description: 'Plan JSON path (leave blank to read from pages/apps/carol/index.json → plan_latest)'\n        required: false\n        default: ''\n  push:\n    paths:\n      - 'pages/apps/carol/index.json'\n      - 'pages/apps/carol/plans/**'\n      - 'scripts/Carol-Extract-Shopping-v3.ps1'\n\npermissions:\n  contents: write\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Confirm PowerShell available\n        run: pwsh -v\n\n      - name: Resolve plan path\n        id: plan\n        shell: pwsh\n        run: |\n          param([string]$Provided = \"${{ github.event.inputs.plan_path }}\")\n          if([string]::IsNullOrWhiteSpace($Provided)){\n            if(!(Test-Path 'pages/apps/carol/index.json')){ throw 'Pointer not found: pages/apps/carol/index.json' }\n            $ptr = Get-Content -Raw 'pages/apps/carol/index.json' | ConvertFrom-Json\n            $p = $ptr.plan_latest\n            if([string]::IsNullOrWhiteSpace($p)){ throw 'plan_latest missing in pointer' }\n            \"value=$p\" | Out-File -FilePath $env:GITHUB_OUTPUT -Append\n          } else {\n            \"value=$Provided\" | Out-File -FilePath $env:GITHUB_OUTPUT -Append\n          }\n\n      - name: Extract shopping (v3)\n        shell: pwsh\n        run: |\n          $Plan = \"${{ steps.plan.outputs.value }}\"\n          Write-Host \"Using plan: $Plan\"\n          if(!(Test-Path $Plan)){ throw \"Plan file not found: $Plan\" }\n          ./scripts/Carol-Extract-Shopping-v3.ps1 -PlanFile $Plan\n\n      - name: Commit shopping outputs\n        shell: bash\n        run: |\n          git config user.name \"github-actions\"\n          git config user.email \"actions@github.com\"\n          git add pages/apps/carol/plans/shopping-*.json || true\n          git commit -m \"Carol: refresh shopping from pointer\" || echo \"No changes to commit\"\n          git push || echo \"No push (possibly no changes)\"\n"
  },
